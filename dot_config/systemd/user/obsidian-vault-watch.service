[Unit]
Description=Watch obsidian-vault and push on local changes
ConditionPathExists=%h/obsidian-vault/.git

[Service]
Type=simple
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/obsidian-vault-watch
Restart=always
RestartSec=5
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=default.target
