[Unit]
Description=Poll-pull obsidian-vault from origin
ConditionPathExists=%h/obsidian-vault/.git

[Service]
Type=oneshot
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/obsidian-vault-pull
TimeoutStartSec=120
Nice=10
IOSchedulingClass=idle
