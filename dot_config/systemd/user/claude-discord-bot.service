[Unit]
Description=Claude Code Discord Notification Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/uv run --project %h/.local/share/chezmoi/claude-discord-bot bot.py
Restart=on-failure
RestartSec=10
# 環境変数は ~/.config/claude-discord-bot/env に定義
EnvironmentFile=%h/.config/claude-discord-bot/env

[Install]
WantedBy=default.target
