// Zellij configuration
// Keybindings are handled directly in Zellij.

// UI configuration
keybinds {
    normal {
{{- if eq .chezmoi.os "darwin" }}
        // macOS-style bindings
        bind "Super t" { NewTab; }
        bind "Super w" { CloseTab; }
{{- else }}
        // Windows/Linux-style bindings
        bind "Ctrl t" { NewTab; }
        bind "Ctrl w" { CloseTab; }
{{- end }}
    }
    shared_except "locked" {
        // Keep navigation keys active across modes.
        bind "Ctrl Tab" { GoToNextTab; }
        bind "Ctrl Shift Tab" { GoToPreviousTab; }
        // Ghostty fallback for Ctrl+Tab combos.
        bind "Alt h" { GoToPreviousTab; }
        bind "Alt l" { GoToNextTab; }
        bind "Super Shift [" { GoToPreviousTab; }
        bind "Super Shift ]" { GoToNextTab; }
        bind "Ctrl ," { FocusPreviousPane; }
        bind "Ctrl ." { FocusNextPane; }
        bind "Alt t" { NewPane; }
        bind "Alt w" { CloseFocus; }
    }
}

ui {
    pane_frames {
        rounded_corners true
    }
}

// Theme
theme "tokyo-night-storm"

// Needed for reliable modified-key detection (eg. Ctrl+Tab) in compatible terminals.
support_kitty_keyboard_protocol true
