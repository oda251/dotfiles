// Zellij configuration
// Tab operation keybindings to work with Ghostty (macOS) and Windows Terminal

keybinds {
    normal {
        // macOS: Cmd+t for new tab (Super key maps to Cmd on macOS)
        bind "Super t" { NewTab; SwitchToMode "Normal"; }
        
        // Windows/Linux: Ctrl+t for new tab
        bind "Ctrl t" { NewTab; SwitchToMode "Normal"; }
        
        // macOS: Cmd+w to close tab
        bind "Super w" { CloseTab; SwitchToMode "Normal"; }
        
        // Windows/Linux: Ctrl+w to close tab
        bind "Ctrl w" { CloseTab; SwitchToMode "Normal"; }
        
        // macOS: Cmd+Shift+[ to go to previous tab
        bind "Super Shift BracketLeft" { GoToPreviousTab; SwitchToMode "Normal"; }
        
        // Windows/Linux: Ctrl+Shift+[ to go to previous tab
        bind "Ctrl Shift BracketLeft" { GoToPreviousTab; SwitchToMode "Normal"; }
        
        // macOS: Cmd+Shift+] to go to next tab
        bind "Super Shift BracketRight" { GoToNextTab; SwitchToMode "Normal"; }
        
        // Windows/Linux: Ctrl+Shift+] to go to next tab
        bind "Ctrl Shift BracketRight" { GoToNextTab; SwitchToMode "Normal"; }
    }
}

// UI configuration
ui {
    pane_frames {
        rounded_corners true
    }
}

// Theme
theme "tokyo-night-storm"
