theme = TokyoNight
maximize = true
font-family = PlemolJP Console NF
background-opacity = 0.8
macos-titlebar-style = tabs
background-blur = true
adjust-cell-height = 2
font-thicken = true
window-inherit-working-directory = true
shell-integration = detect
macos-option-as-alt = left
copy-on-select = true
quick-terminal-position = "top"
quick-terminal-screen = "main"
quick-terminal-animation-duration = 0.3
keybind = "global:alt+`=toggle_quick_terminal"
macos-non-native-fullscreen = true
window-decoration = false

# Zellij operations via single key sends for better repeat stability
# Send Alt+n/x/h/l and bind them directly in Zellij normal mode
keybind = "cmd+t=text:\x1bn"
keybind = "cmd+w=text:\x1bx"
keybind = "cmd+shift+bracket_left=text:\x1bh"
keybind = "cmd+shift+bracket_right=text:\x1bl"
keybind = "ctrl+tab=text:\x1bl"
keybind = "ctrl+shift+tab=text:\x1bh"
# Pane navigation
keybind = "ctrl+comma=text:\x1b,"
keybind = "ctrl+period=text:\x1b."
