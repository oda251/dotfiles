theme = TokyoNight
maximize = true
font-family = PlemolJP Console NF
background-opacity = 0.8
macos-titlebar-style = tabs
background-blur = true
adjust-cell-height = 2
font-thicken = true
window-inherit-working-directory = true
shell-integration = detect
command = /bin/zsh
macos-option-as-alt = left
copy-on-select = true
quick-terminal-position = "top"
quick-terminal-screen = "main"
quick-terminal-animation-duration = 0.3
keybind = "global:ctrl+`=toggle_quick_terminal"
macos-non-native-fullscreen = true
window-decoration = false

# Unbind keys the terminal workspace manager (herdr) needs, so Ghostty
# passes them through instead of claiming its own defaults.
keybind = "super+t=unbind"
keybind = "super+w=unbind"
keybind = "super+shift+bracket_left=unbind"
keybind = "super+shift+bracket_right=unbind"
keybind = "ctrl+comma=unbind"
keybind = "ctrl+period=unbind"

# Improve readability for completion/secondary text while keeping TokyoNight base
selection-background = 364a82
selection-foreground = c0caf5
palette = 0=#24283b
palette = 4=#7aa2f7
palette = 6=#89ddff
palette = 7=#d5d6db
palette = 8=#7f8db8
palette = 15=#ffffff
