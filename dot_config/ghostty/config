theme = TokyoNight
maximize = true
font-family = PlemolJP Console NF
background-opacity = 0.8
macos-titlebar-style = tabs
background-blur = true
adjust-cell-height = 2
font-thicken = true
window-inherit-working-directory = true
shell-integration = detect
macos-option-as-alt = left
copy-on-select = true
quick-terminal-position = "top"
quick-terminal-screen = "main"
quick-terminal-animation-duration = 0.3
keybind = "global:alt+`=toggle_quick_terminal"

# Zellij tab operations - send Zellij CLI commands directly
keybind = cmd+t=text:zellij action new-tab\n
keybind = cmd+w=text:zellij action close-tab\n
keybind = cmd+shift+bracketleft=text:zellij action go-to-previous-tab\n
keybind = cmd+shift+bracketright=text:zellij action go-to-next-tab\n
