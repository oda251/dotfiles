zellij = "latest"
{{- if ne .chezmoi.os "darwin" }}
make = "latest"
{{- end }}
"github:anomalyco/opencode" = "latest"
bottom = "latest"
oxlint = "latest"
"npm:oxfmt" = "latest"
"npm:@googleworkspace/cli" = "latest"

git-lfs = "latest"
lefthook = "latest"
"npm:ctx7" = "latest"
"npm:@onegai/cli" = "latest"
{{- end }}
