[tools]
{{- if ne .chezmoi.os "windows" }}
# Runtimes
node = "latest"
npm = "latest"
"npm:@github/copilot" = "prerelease"
"npm:@playwright/cli" = "latest"
"npm:@openai/codex" = "latest"
"npm:wrangler" = "latest"
uv = "latest"
bun = "latest"
rust = "stable"
awscli = "latest"
terraform = "latest"
terragrunt = "latest"
go = "latest"
{{- end }}

# Modern CLI Tools
fzf = "latest"
fd = "latest"
ripgrep = "latest"
bat = "latest"
{{- if eq .chezmoi.os "windows" }}
"github:eza-community/eza" = "latest"
{{- else }}
eza = "latest"
{{- end }}
zoxide = "latest"
starship = "latest"
yazi = "latest"
lazygit = "latest"
delta = "latest"
gh = "latest"
jq = "latest"
neovim = "latest"

{{- if ne .chezmoi.os "windows" }}
"ubi:Infisical/cli" = { version = "latest", exe = "infisical" }
