#!/usr/bin/env bash
set -euo pipefail

SETTINGS="$HOME/.claude/settings.json"
CACHE="$HOME/.cache/otlp-credentials"

# Fetch OTLP credentials from Pulumi ESC
key=$(pulumi env open oda251/dotfiles/prod environmentVariables.NEWRELIC_LICENSE_KEY 2>/dev/null | tr -d '"') || exit 0
endpoint=$(pulumi env open oda251/dotfiles/prod environmentVariables.NEWRELIC_OTLP_ENDPOINT 2>/dev/null | tr -d '"') || exit 0

[ -z "$key" ] && exit 0
[ -z "$endpoint" ] && exit 0

header="Api-Key=${key}"

# Update cache for chezmoi template
mkdir -p "$(dirname "$CACHE")"
printf '%s\n%s\n' "$endpoint" "$header" > "$CACHE"

# Update settings.json for current/next session
current_header=$(jq -r '.env.OTEL_EXPORTER_OTLP_HEADERS // ""' "$SETTINGS" 2>/dev/null) || exit 0
current_endpoint=$(jq -r '.env.OTEL_EXPORTER_OTLP_ENDPOINT // ""' "$SETTINGS" 2>/dev/null) || exit 0

if [ "$current_header" != "$header" ] || [ "$current_endpoint" != "$endpoint" ]; then
  tmp=$(mktemp)
  jq --arg h "$header" --arg e "$endpoint" \
    '.env.OTEL_EXPORTER_OTLP_HEADERS = $h | .env.OTEL_EXPORTER_OTLP_ENDPOINT = $e' \
    "$SETTINGS" > "$tmp" && mv "$tmp" "$SETTINGS"
fi
