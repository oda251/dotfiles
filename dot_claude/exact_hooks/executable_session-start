#!/usr/bin/env bash
set -euo pipefail

CLAUDE_DIR="$HOME/.claude"

# Read main agent instruction
main_agent_content=$(cat "${CLAUDE_DIR}/hooks/bootstrap/MAIN_AGENT.md" 2>&1 || echo "Error reading main agent instruction")

# Escape string for JSON embedding
escape_for_json() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

main_agent_escaped=$(escape_for_json "$main_agent_content")
session_context="<EXTREMELY_IMPORTANT>\n${main_agent_escaped}\n</EXTREMELY_IMPORTANT>"

# Output context injection (Claude Code format)
printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"

exit 0
