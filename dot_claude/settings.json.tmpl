{
  "skipDangerousModePermissionPrompt": true,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "{{ onepasswordRead "op://dotfiles/grafana-cloud-otlp/OTLP Configuration/endpoint" }}",
    "OTEL_EXPORTER_OTLP_HEADERS": "Authorization=Basic {{ onepasswordRead "op://dotfiles/grafana-cloud-otlp/OTLP Configuration/basic-auth" }}",
    "OTEL_LOG_USER_PROMPTS": "1"
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/session-start\"",
            "async": false
          }
        ]
      }
    ]
  }
}
