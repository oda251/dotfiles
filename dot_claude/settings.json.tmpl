{
  "skipDangerousModePermissionPrompt": true,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    {{- $cache := joinPath .chezmoi.homeDir ".cache/otlp-credentials" }}
    {{- $endpoint := "" }}
    {{- $header := "" }}
    {{- if stat $cache }}
    {{-   $lines := splitList "\n" (include $cache | trim) }}
    {{-   if ge (len $lines) 2 }}
    {{-     $endpoint = index $lines 0 }}
    {{-     $header = index $lines 1 }}
    {{-   end }}
    {{- end }}
    {{- if and (eq $endpoint "") (lookPath "infisical") }}
    {{-   $endpoint = output "bash" "-c" "infisical secrets get NEWRELIC_OTLP_ENDPOINT --plain --silent --env prod --path /generated 2>/dev/null || true" | trim }}
    {{-   $key := output "bash" "-c" "infisical secrets get NEWRELIC_LICENSE_KEY --plain --silent --env prod --path /generated 2>/dev/null || true" | trim }}
    {{-   if ne $key "" }}
    {{-     $header = printf "Api-Key=%s" $key }}
    {{-   end }}
    {{- end }}
    "OTEL_EXPORTER_OTLP_ENDPOINT": "{{ $endpoint }}",
    "OTEL_EXPORTER_OTLP_HEADERS": "{{ $header }}",
    "OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE": "delta",
    "OTEL_LOG_USER_PROMPTS": "1",
    "OTEL_LOG_TOOL_DETAILS": "1",
    "OTEL_METRICS_INCLUDE_VERSION": "true"
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/session-start\"",
            "async": false
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/refresh-otlp-key\"",
            "async": true
          }
        ]
      }
    ]
  }
}
