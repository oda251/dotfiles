{{- if eq .chezmoi.os "darwin" }}
alias chrome="open -a 'Google Chrome'"
alias idea="open -a 'IntelliJ IDEA'"
alias pwb="git rev-parse --abbrev-ref HEAD | pbcopy"
alias copy='pbcopy'
{{- else if eq .chezmoi.os "linux" }}
if [[ -n "${WSL_DISTRO_NAME:-}" ]]; then
    alias copy='clip.exe'
    alias paste='powershell.exe -NoProfile -Command Get-Clipboard'
    alias pwb="git rev-parse --abbrev-ref HEAD | clip.exe"
elif command -v wl-copy &> /dev/null; then
    alias copy='wl-copy'
elif command -v xclip &> /dev/null; then
    alias copy='xclip -selection clipboard'
    alias paste='xclip -selection clipboard -o'
    alias pwb="git rev-parse --abbrev-ref HEAD | xclip -selection clipboard"
elif command -v xsel &> /dev/null; then
    alias copy='xsel --clipboard --input'
    alias paste='xsel --clipboard --output'
    alias pwb="git rev-parse --abbrev-ref HEAD | xsel --clipboard --input"
fi

obsidian() {
  local socket="${XDG_RUNTIME_DIR:-$HOME}/.obsidian-cli.sock"
  if [[ -S "$socket" ]]; then
    command obsidian "$@"
  else
    (nohup /opt/Obsidian/obsidian "$@" >/dev/null 2>&1 &)
  fi
}
{{- end }}

alias ls='eza --icons=auto'
cat() {
  if [[ -t 0 ]]; then
    bat --style=auto "$@"
  else
    bat --style=plain "$@"
  fi
}
alias df='df -h'
alias v='nvim'
alias lg='lazygit'
alias now="date '+%Y%m%d%H%M%S'"
slidev() { local args=(); for a in "$@"; do [[ -e "$a" ]] && args+=("$(realpath "$a")") || args+=("$a"); done; local cwd="$PWD"; cd ~/.local/share/chezmoi && npx slidev "${args[@]}"; cd "$cwd"; }
alias copilot='copilot --allow-all-tools'

claude() {
  command claude --dangerously-skip-permissions --remote-control "$@"
}

codex() {
  command codex --ask-for-approval never --sandbox danger-full-access "$@"
}

function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
	yazi "$@" --cwd-file="$tmp"
	if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
		builtin cd -- "$cwd"
	fi
	rm -f -- "$tmp"
}

# ghq クローン済みリポジトリへ fzf で cd
cdg() {
  command -v ghq >/dev/null 2>&1 || { echo "ghq not found" >&2; return 1; }
  local root repo
  root="$(ghq root)" || return 1
  repo=$(ghq list | fzf --height 40% --reverse --preview "ls -la $root/{}") || return
  builtin cd -- "$root/$repo"
}

# ghq クローン済みリポジトリを fzf で選んで削除（複数可）
rmg() {
  command -v ghq >/dev/null 2>&1 || { echo "ghq not found" >&2; return 1; }
  local root repos
  root="$(ghq root)" || return 1
  repos=$(ghq list | fzf -m --height 40% --reverse --preview "ls -la $root/{}") || return
  [[ -z "$repos" ]] && return
  while IFS= read -r repo; do
    [[ -z "$repo" ]] && continue
    ghq rm -- "$repo" < /dev/tty
  done <<< "$repos"
}

# gwq worktree へ fzf で cd
cdw() {
  command -v gwq >/dev/null 2>&1 || { echo "gwq not found" >&2; return 1; }
  command -v jq >/dev/null 2>&1 || { echo "jq not found" >&2; return 1; }
  local target
  target=$(gwq list -g --json 2>/dev/null \
    | jq -r '.[] | "\(.branch)\t\(.path)"' \
    | fzf --height 40% --reverse --with-nth=1 --delimiter='\t' \
    | awk -F'\t' '{print $2}') || return
  [[ -d "$target" ]] && builtin cd -- "$target"
}
