{{- if eq .chezmoi.os "darwin" }}
alias chrome="open -a 'Google Chrome'"
alias idea="open -a 'IntelliJ IDEA'"
alias pwb="git rev-parse --abbrev-ref HEAD | pbcopy"
alias copy='pbcopy'
{{- else if eq .chezmoi.os "linux" }}
if command -v wl-copy &> /dev/null; then
    alias copy='wl-copy'
elif command -v xclip &> /dev/null; then
    alias copy='xclip -selection clipboard'
    alias paste='xclip -selection clipboard -o'
    alias pwb="git rev-parse --abbrev-ref HEAD | xclip -selection clipboard"
elif command -v xsel &> /dev/null; then
    alias copy='xsel --clipboard --input'
    alias paste='xsel --clipboard --output'
    alias pwb="git rev-parse --abbrev-ref HEAD | xsel --clipboard --input"
fi
{{- end }}

alias ls='eza --icons'
alias df='df -h'
alias cd='z'
alias v='nvim'
alias dk='diskonaut'
alias lg='lazygit'
alias now="date '+%Y%m%d%H%M%S'"
alias copilot='copilot --allow-all-tools'

function wt() {
  local subcmd="$1"

  if [[ "$subcmd" != "add" && "$subcmd" != "ls" && "$subcmd" != "rm" && "$subcmd" != "cd" ]]; then
    git worktree "$@"
    return $?
  fi

  local repo_root
  repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    echo "wt: not inside a git repository" >&2
    return 1
  }

  if [[ "$subcmd" == "ls" ]]; then
    shift
    git -C "$repo_root" worktree list "$@"
    return $?
  fi

  if [[ "$subcmd" == "add" ]]; then
    shift
    local branch="$1"
    if [[ -z "$branch" ]]; then
      echo "usage: wt add <branch-name>" >&2
      return 1
    fi

    local repo_name parent_dir safe_branch worktree_dir
    repo_name="$(basename "$repo_root")"
    parent_dir="$(dirname "$repo_root")"
    safe_branch="${branch//\//__}"
    worktree_dir="$parent_dir/${repo_name}@${safe_branch}"

    local existing_worktree
    existing_worktree="$(
      git -C "$repo_root" worktree list --porcelain \
        | awk -v b="refs/heads/$branch" '
            $1 == "worktree" { p = $2 }
            $1 == "branch" && $2 == b { print p; exit }
          '
    )"

    if [[ -n "$existing_worktree" ]]; then
      worktree_dir="$existing_worktree"
      echo "wt: branch '$branch' already has a worktree at $worktree_dir"
    elif git -C "$repo_root" show-ref --verify --quiet "refs/heads/$branch"; then
      if ! git -C "$repo_root" worktree add "$worktree_dir" "$branch"; then
        [[ -d "$worktree_dir" ]] || return 1
      fi
    else
      local main_branch
      main_branch="$(git -C "$repo_root" symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's|refs/remotes/origin/||')"
      if [[ -z "$main_branch" ]]; then
        for candidate in main master; do
          if git -C "$repo_root" show-ref --verify --quiet "refs/heads/$candidate"; then
            main_branch="$candidate"
            break
          fi
        done
      fi
      if [[ -z "$main_branch" ]]; then
        echo "wt: could not determine main branch" >&2
        return 1
      fi
      if ! git -C "$repo_root" worktree add -b "$branch" "$worktree_dir" "$main_branch"; then
        [[ -d "$worktree_dir" ]] || return 1
      fi
    fi

    __wt_open_in_tab "$worktree_dir" "$branch"

    return 0
  fi

  if [[ "$subcmd" == "cd" ]]; then
    shift
    wtcd "$@"
    return $?
  fi

  shift
  local remove_opts=()
  while [[ "$1" == -* ]]; do
    remove_opts+=("$1")
    shift
  done

  local target="$1"
  local worktree_dir

  if [[ -z "$target" ]]; then
    worktree_dir="$(__wt_select "$repo_root" "WT RM>")" || return $?
  elif [[ -d "$target" ]]; then
    worktree_dir="$(cd "$target" && pwd -P)"
  else
    worktree_dir="$(
      git -C "$repo_root" worktree list --porcelain \
        | awk -v b="refs/heads/$target" '
            $1 == "worktree" { p = $2 }
            $1 == "branch" && $2 == b { print p; exit }
          '
    )"
  fi

  if [[ -z "$worktree_dir" ]]; then
    echo "wt: worktree not found for '$target'" >&2
    return 1
  fi

  git -C "$repo_root" worktree remove "${remove_opts[@]}" "$worktree_dir"
}

function __wt_open_in_tab() {
  local worktree_dir="$1"
  local tab_name="$2"

  if command -v zellij >/dev/null 2>&1; then
    if [[ -n "$ZELLIJ" ]]; then
      zellij action new-tab --name "$tab_name"
      zellij action write-chars " builtin cd -- ${(qq)worktree_dir} && clear"
      zellij action write 13
    else
      zellij --cwd "$worktree_dir"
    fi
  else
    builtin cd "$worktree_dir" || return $?
  fi
}

function __wt_branch_from_path() {
  local repo_root="$1"
  local worktree_dir="$2"

  git -C "$repo_root" worktree list --porcelain \
    | awk -v p="$worktree_dir" '
        $1 == "worktree" && $2 == p { found = 1; next }
        found && $1 == "branch" { sub("refs/heads/", "", $2); print $2; exit }
        found && $0 == "" { exit }
      '
}

function __wt_select() {
  local repo_root="$1"
  local prompt="${2:-WORKTREE>}"

  local entries
  entries="$(
    git -C "$repo_root" worktree list --porcelain \
      | awk '
          $1 == "worktree" { p = $2; b = "(detached)"; seen = 1; next }
          $1 == "branch" { sub("refs/heads/", "", $2); b = $2; next }
          $0 == "" && seen {
            paths[++n] = p; branches[n] = b
            if (length(b) > maxlen) maxlen = length(b)
            seen = 0
          }
          END {
            if (seen) { paths[++n] = p; branches[n] = b; if (length(b) > maxlen) maxlen = length(b) }
            for (i = 1; i <= n; i++)
              printf "%s\t%-*s  %s\n", paths[i], maxlen, branches[i], paths[i]
          }
        '
  )"

  if [[ -z "$entries" ]]; then
    echo "wt: no worktrees found" >&2
    return 1
  fi

  local selected
  if command -v fzf >/dev/null 2>&1; then
    selected="$(
      printf '%s\n' "$entries" \
        | fzf --delimiter=$'\t' --with-nth=2 --prompt="$prompt " --height=40% --reverse
    )"
    [[ -z "$selected" ]] && return 1
    printf '%s' "${selected%%$'\t'*}"
  else
    local -a worktree_paths worktree_labels
    local line path label
    while IFS=$'\t' read -r path label; do
      worktree_paths+=("$path")
      worktree_labels+=("$label")
    done <<< "$entries"

    PS3="$prompt "
    select line in "${worktree_labels[@]}"; do
      [[ -z "$line" ]] && continue
      printf '%s' "${worktree_paths[REPLY]}"
      break
    done
  fi
}

function wtcd() {
  local repo_root
  repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    echo "wtcd: not inside a git repository" >&2
    return 1
  }

  local target="$1"
  local worktree_dir branch_name

  if [[ -n "$target" ]]; then
    if [[ -d "$target" ]]; then
      worktree_dir="$(cd "$target" && pwd -P)"
    else
      worktree_dir="$(
        git -C "$repo_root" worktree list --porcelain \
          | awk -v b="refs/heads/$target" '
              $1 == "worktree" { p = $2 }
              $1 == "branch" && $2 == b { print p; exit }
            '
      )"
    fi

    if [[ -z "$worktree_dir" ]]; then
      echo "wtcd: worktree not found for '$target'" >&2
      return 1
    fi
  else
    worktree_dir="$(__wt_select "$repo_root" "WTCD>")" || return $?
  fi

  branch_name="$(__wt_branch_from_path "$repo_root" "$worktree_dir")"
  : "${branch_name:=$(basename "$worktree_dir")}"

  __wt_open_in_tab "$worktree_dir" "$branch_name"
}

codex() {
  command codex --ask-for-approval never --sandbox danger-full-access "$@"
}

claude() {
  command claude --dangerously-skip-permissions "$@"
}

function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
	yazi "$@" --cwd-file="$tmp"
	if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
		builtin cd -- "$cwd"
	fi
	rm -f -- "$tmp"
}
