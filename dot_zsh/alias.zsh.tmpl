{{- if eq .chezmoi.os "darwin" }}
alias chrome="open -a 'Google Chrome'"
alias idea="open -a 'IntelliJ IDEA'"
alias pwb="git rev-parse --abbrev-ref HEAD | pbcopy"
alias copy='pbcopy'
{{- else if eq .chezmoi.os "linux" }}
if command -v xclip &> /dev/null; then
    alias pbcopy='xclip -selection clipboard'
    alias pbpaste='xclip -selection clipboard -o'
    alias pwb="git rev-parse --abbrev-ref HEAD | xclip -selection clipboard"
elif command -v xsel &> /dev/null; then
    alias pbcopy='xsel --clipboard --input'
    alias pbpaste='xsel --clipboard --output'
    alias pwb="git rev-parse --abbrev-ref HEAD | xsel --clipboard --input"
fi
if command -v wl-copy &> /dev/null; then
    alias copy='wl-copy'
fi
{{- end }}

alias ls='eza --icons'
alias cat='bat'
alias cd='z'
alias vim='nvim'
alias grep='rg'
alias dk='diskonaut'
alias now="date '+%Y%m%d%H%M%S'"
alias copilot='copilot --allow-all-tools'
alias wt='git worktree'
