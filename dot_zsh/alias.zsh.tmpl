{{- if eq .chezmoi.os "darwin" }}
alias chrome="open -a 'Google Chrome'"
alias idea="open -a 'IntelliJ IDEA'"
alias pwb="git rev-parse --abbrev-ref HEAD | pbcopy"
alias copy='pbcopy'
{{- else if eq .chezmoi.os "linux" }}
if [[ -n "${WSL_DISTRO_NAME:-}" ]]; then
    alias copy='clip.exe'
    alias paste='powershell.exe -NoProfile -Command Get-Clipboard'
    alias pwb="git rev-parse --abbrev-ref HEAD | clip.exe"
elif command -v wl-copy &> /dev/null; then
    alias copy='wl-copy'
elif command -v xclip &> /dev/null; then
    alias copy='xclip -selection clipboard'
    alias paste='xclip -selection clipboard -o'
    alias pwb="git rev-parse --abbrev-ref HEAD | xclip -selection clipboard"
elif command -v xsel &> /dev/null; then
    alias copy='xsel --clipboard --input'
    alias paste='xsel --clipboard --output'
    alias pwb="git rev-parse --abbrev-ref HEAD | xsel --clipboard --input"
fi

obsidian() {
  local socket="${XDG_RUNTIME_DIR:-$HOME}/.obsidian-cli.sock"
  if [[ -S "$socket" ]]; then
    command obsidian "$@"
  else
    nohup /opt/Obsidian/obsidian "$@" >/dev/null 2>&1 & disown
  fi
}
{{- end }}

alias ls='eza --icons=auto'
cat() {
  if [[ -t 0 ]]; then
    bat --style=auto "$@"
  else
    bat --style=plain "$@"
  fi
}
alias df='df -h'
alias v='nvim'
alias lg='lazygit'
alias now="date '+%Y%m%d%H%M%S'"
slidev() { local args=(); for a in "$@"; do [[ -e "$a" ]] && args+=("$(realpath "$a")") || args+=("$a"); done; local cwd="$PWD"; cd ~/.local/share/chezmoi && npx slidev "${args[@]}"; cd "$cwd"; }
alias copilot='copilot --allow-all-tools'

claude() {
  command claude --dangerously-skip-permissions --remote-control "$@"
}

codex() {
  command codex --ask-for-approval never --sandbox danger-full-access "$@"
}

function wt() {
  local subcmd="$1"

  if [[ "$subcmd" != "add" && "$subcmd" != "ls" && "$subcmd" != "rm" && "$subcmd" != "cd" ]]; then
    git worktree "$@"
    return $?
  fi

  local repo_root
  repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    echo "wt: not inside a git repository" >&2
    return 1
  }

  if [[ "$subcmd" == "ls" ]]; then
    shift
    if [[ "$#" -gt 0 ]]; then
      git -C "$repo_root" worktree list "$@"
      return $?
    fi
    __wt_print_list "$repo_root"
    return $?
  fi

  if [[ "$subcmd" == "add" ]]; then
    shift
    local branch="$1"
    if [[ -z "$branch" ]]; then
      echo "usage: wt add <branch-name|issue-number|issue-url>" >&2
      return 1
    fi

    if [[ "$branch" =~ ^[0-9]+$ || "$branch" =~ ^https:// ]]; then
      local issue_json
      issue_json="$(gh issue view "$branch" --json number,title 2>/dev/null)" || {
        echo "wt: failed to fetch issue '$branch'" >&2
        return 1
      }
      local issue_number issue_title slug
      issue_number="$(echo "$issue_json" | jq -r '.number')"
      issue_title="$(echo "$issue_json" | jq -r '.title')"
      slug="$(echo "$issue_title" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g; s/--*/-/g; s/^-//; s/-$//')"
      if [[ -z "$slug" ]]; then
        echo "wt: title='$issue_title' (non-ASCII removed)"
        printf "wt: slug (empty=feat/%s): " "$issue_number"
        read -r slug
        slug="$(echo "$slug" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g; s/--*/-/g; s/^-//; s/-$//')"
      fi
      if [[ -n "$slug" ]]; then
        branch="feat/${issue_number}-${slug}"
      else
        branch="feat/${issue_number}"
      fi
      echo "wt: branch → $branch"
    fi

    local repo_name parent_dir safe_branch worktree_dir
    repo_name="$(basename "$repo_root")"
    repo_name="${repo_name%%@*}"
    parent_dir="$(dirname "$repo_root")"
    safe_branch="${branch//\//__}"
    worktree_dir="$parent_dir/${repo_name}@${safe_branch}"

    local existing_worktree
    existing_worktree="$(
      git -C "$repo_root" worktree list --porcelain \
        | awk -v b="refs/heads/$branch" '
            $1 == "worktree" { p = $2 }
            $1 == "branch" && $2 == b { print p; exit }
          '
    )"

    if [[ -n "$existing_worktree" ]]; then
      worktree_dir="$existing_worktree"
      echo "wt: branch '$branch' already has a worktree at $worktree_dir"
    elif git -C "$repo_root" show-ref --verify --quiet "refs/heads/$branch"; then
      if ! git -C "$repo_root" worktree add "$worktree_dir" "$branch"; then
        [[ -d "$worktree_dir" ]] || return 1
      fi
    else
      local main_branch
      main_branch="$(git -C "$repo_root" symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's|refs/remotes/origin/||')"
      if [[ -z "$main_branch" ]]; then
        for candidate in main master; do
          if git -C "$repo_root" show-ref --verify --quiet "refs/heads/$candidate"; then
            main_branch="$candidate"
            break
          fi
        done
      fi
      if [[ -z "$main_branch" ]]; then
        echo "wt: could not determine main branch" >&2
        return 1
      fi
      if ! git -C "$repo_root" worktree add -b "$branch" "$worktree_dir" "$main_branch"; then
        [[ -d "$worktree_dir" ]] || return 1
      fi
    fi

    __wt_open_in_tab "$worktree_dir" "$branch"

    return 0
  fi

  if [[ "$subcmd" == "cd" ]]; then
    shift
    wtcd "$@"
    return $?
  fi

  shift
  local remove_opts=()
  while [[ "$1" == -* ]]; do
    remove_opts+=("$1")
    shift
  done

  local target="$1"
  local worktree_dir

  if [[ -z "$target" ]]; then
    worktree_dir="$(__wt_select "$repo_root" "WT RM>")" || return $?
  elif [[ -d "$target" ]]; then
    worktree_dir="$(cd "$target" && pwd -P)"
  else
    worktree_dir="$(
      git -C "$repo_root" worktree list --porcelain \
        | awk -v b="refs/heads/$target" '
            $1 == "worktree" { p = $2 }
            $1 == "branch" && $2 == b { print p; exit }
          '
    )"
  fi

  if [[ -z "$worktree_dir" ]]; then
    echo "wt: worktree not found for '$target'" >&2
    return 1
  fi

  git -C "$repo_root" worktree remove "${remove_opts[@]}" "$worktree_dir"
}

function __wt_open_in_tab() {
  local worktree_dir="$1"
  local tab_name="$2"

  if command -v zellij >/dev/null 2>&1; then
    if [[ -n "$ZELLIJ" ]]; then
{{- if eq .chezmoi.os "darwin" }}
      # macOS: Zellij が /proc を持たず --cwd が機能しないため write-chars で cd を送信
      zellij action new-tab --name "$tab_name"
      zellij action write-chars " builtin cd -- ${(qq)worktree_dir} && clear"
      zellij action write 13
{{- else }}
      zellij action new-tab --name "$tab_name" --cwd "$worktree_dir"
{{- end }}
    else
      zellij --cwd "$worktree_dir"
    fi
  else
    builtin cd "$worktree_dir" || return $?
  fi
}

function __wt_branch_from_path() {
  local repo_root="$1"
  local worktree_dir="$2"

  git -C "$repo_root" worktree list --porcelain \
    | awk -v p="$worktree_dir" '
        $1 == "worktree" && $2 == p { found = 1; next }
        found && $1 == "branch" { sub("refs/heads/", "", $2); print $2; exit }
        found && $0 == "" { exit }
      '
}

function __wt_select() {
  local repo_root="$1"
  local prompt="${2:-WORKTREE>}"

  local entries
  entries="$(__wt_entries "$repo_root")"

  if [[ -z "$entries" ]]; then
    echo "wt: no worktrees found" >&2
    return 1
  fi

  local selected
  if command -v fzf >/dev/null 2>&1; then
    selected="$(
      printf '%s\n' "$entries" \
        | fzf --delimiter=$'\t' --with-nth=2 --prompt="$prompt " --height=40% --reverse
    )"
    [[ -z "$selected" ]] && return 1
    printf '%s' "${selected%%$'\t'*}"
  else
    local -a worktree_paths worktree_labels
    local line path label
    while IFS=$'\t' read -r path label; do
      worktree_paths+=("$path")
      worktree_labels+=("$label")
    done <<< "$entries"

    PS3="$prompt "
    select line in "${worktree_labels[@]}"; do
      [[ -z "$line" ]] && continue
      printf '%s' "${worktree_paths[REPLY]}"
      break
    done
  fi
}

function __wt_entries() {
  local repo_root="$1"

  git -C "$repo_root" worktree list --porcelain \
    | awk '
        $1 == "worktree" { worktree_path = $2; branch_name = "(detached)"; seen = 1; next }
        $1 == "branch" { sub("refs/heads/", "", $2); branch_name = $2; next }
        $0 == "" && seen {
          printf "%s\t%s\n", worktree_path, branch_name
          seen = 0
        }
        END {
          if (seen) {
            printf "%s\t%s\n", worktree_path, branch_name
          }
        }
      '
}

function __wt_print_list() {
  local repo_root="$1"
  local current_worktree_path
  current_worktree_path="$(pwd -P)"

  __wt_entries "$repo_root" \
    | awk -F '\t' -v current_path="$current_worktree_path" '
        {
          rows[++row_count, "path"] = $1
          rows[row_count, "branch"] = $2
          if (length($2) > branch_width) branch_width = length($2)
        }
        END {
          if (row_count == 0) exit 1
          for (index = 1; index <= row_count; index++) {
            marker = rows[index, "path"] == current_path ? "*" : " "
            printf "%s %-*s  %s\n", marker, branch_width, rows[index, "branch"], rows[index, "path"]
          }
        }
      '
}

function wtcd() {
  local repo_root
  repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    echo "wtcd: not inside a git repository" >&2
    return 1
  }

  local target="$1"
  local worktree_dir branch_name

  if [[ -n "$target" ]]; then
    if [[ -d "$target" ]]; then
      worktree_dir="$(cd "$target" && pwd -P)"
    else
      worktree_dir="$(
        git -C "$repo_root" worktree list --porcelain \
          | awk -v b="refs/heads/$target" '
              $1 == "worktree" { p = $2 }
              $1 == "branch" && $2 == b { print p; exit }
            '
      )"
    fi

    if [[ -z "$worktree_dir" ]]; then
      echo "wtcd: worktree not found for '$target'" >&2
      return 1
    fi
  else
    worktree_dir="$(__wt_select "$repo_root" "WTCD>")" || return $?
  fi

  branch_name="$(__wt_branch_from_path "$repo_root" "$worktree_dir")"
  : "${branch_name:=$(basename "$worktree_dir")}"

  __wt_open_in_tab "$worktree_dir" "$branch_name"
}


function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
	yazi "$@" --cwd-file="$tmp"
	if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
		builtin cd -- "$cwd"
	fi
	rm -f -- "$tmp"
}
