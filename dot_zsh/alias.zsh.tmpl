{{- if eq .chezmoi.os "darwin" }}
alias chrome="open -a 'Google Chrome'"
alias idea="open -a 'IntelliJ IDEA'"
alias pwb="git rev-parse --abbrev-ref HEAD | pbcopy"
alias copy='pbcopy'
{{- else if eq .chezmoi.os "linux" }}
if [[ -n "${WSL_DISTRO_NAME:-}" ]]; then
    alias copy='clip.exe'
    alias paste='powershell.exe -NoProfile -Command Get-Clipboard'
    alias pwb="git rev-parse --abbrev-ref HEAD | clip.exe"
elif command -v wl-copy &> /dev/null; then
    alias copy='wl-copy'
elif command -v xclip &> /dev/null; then
    alias copy='xclip -selection clipboard'
    alias paste='xclip -selection clipboard -o'
    alias pwb="git rev-parse --abbrev-ref HEAD | xclip -selection clipboard"
elif command -v xsel &> /dev/null; then
    alias copy='xsel --clipboard --input'
    alias paste='xsel --clipboard --output'
    alias pwb="git rev-parse --abbrev-ref HEAD | xsel --clipboard --input"
fi

obsidian() {
  local socket="${XDG_RUNTIME_DIR:-$HOME}/.obsidian-cli.sock"
  if [[ -S "$socket" ]]; then
    command obsidian "$@"
  else
    (nohup /opt/Obsidian/obsidian "$@" >/dev/null 2>&1 &)
  fi
}
{{- end }}

alias ls='eza --icons=auto'
cat() {
  if [[ -t 0 ]]; then
    bat --style=auto "$@"
  else
    bat --style=plain "$@"
  fi
}
alias df='df -h'
alias v='nvim'
alias lg='lazygit'
alias now="date '+%Y%m%d%H%M%S'"
slidev() { local args=(); for a in "$@"; do [[ -e "$a" ]] && args+=("$(realpath "$a")") || args+=("$a"); done; local cwd="$PWD"; cd ~/.local/share/chezmoi && npx slidev "${args[@]}"; cd "$cwd"; }
alias copilot='copilot --allow-all-tools'

claude() {
  command claude --dangerously-skip-permissions --remote-control "$@"
}

codex() {
  command codex --ask-for-approval never --sandbox danger-full-access "$@"
}

function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
	yazi "$@" --cwd-file="$tmp"
	if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
		builtin cd -- "$cwd"
	fi
	rm -f -- "$tmp"
}

_fzf_repo_preview='eza --tree --level=2 --color=always --icons=auto'

# ghq クローン済みリポジトリへ fzf で cd
cdg() {
  command -v ghq >/dev/null 2>&1 || { echo "ghq not found" >&2; return 1; }
  local root repo
  root="$(ghq root)" || return 1
  repo=$(ghq list | fzf --preview "$_fzf_repo_preview $root/{}") || return
  builtin cd -- "$root/$repo"
}

# ghq クローン済みリポジトリを fzf で選んで削除（複数可）
rmg() {
  command -v ghq >/dev/null 2>&1 || { echo "ghq not found" >&2; return 1; }
  local root repos
  root="$(ghq root)" || return 1
  repos=$(ghq list | fzf -m --preview "$_fzf_repo_preview $root/{}") || return
  [[ -z "$repos" ]] && return
  while IFS= read -r repo; do
    [[ -z "$repo" ]] && continue
    ghq rm -- "$repo" < /dev/tty
  done <<< "$repos"
}

# gh で取れる repo を fzf で選んで ghq get → cd（無引数=自分、引数=owner/org）
# 注: gh repo list はページネーションを内部で完了させてから出力するため、
#     fzf には全件揃ってから流れる (体感は数百ms-数秒の待ちあり)
getg() {
  command -v gh  >/dev/null 2>&1 || { echo "gh not found"  >&2; return 1; }
  command -v ghq >/dev/null 2>&1 || { echo "ghq not found" >&2; return 1; }
  local owner=${1:-} pick url
  pick=$(gh repo list ${owner:+"$owner"} --limit 1000 \
      --json nameWithOwner,description,url \
      -q '.[] | [.nameWithOwner, (.description // ""), .url] | @tsv' \
    | fzf --with-nth=1,2 --delimiter='\t' --preview 'echo {2}') || return
  url=$(awk -F'\t' '{print $3}' <<< "$pick")
  [[ -z "$url" ]] && return
  ghq get -- "$url" || return
  builtin cd -- "$(ghq root)/${url#https://}"
}

# worktree へ fzf で cd
# 既定: cwd が属する repo の worktree のみ。-g で ghq 管理下の全 repo を対象。
# gwq list -g は worktree ごとに git を叩くため激遅 (実測 ~2s/件)。
# 代わりに git worktree list --porcelain を直接読む。
# 表示は "owner/repo  branch  path" の3カラム整列、検索対象は 1,2 カラムのみ。
cdw() {
  command -v ghq >/dev/null 2>&1 || { echo "ghq not found" >&2; return 1; }
  local repos=()
  if [[ "$1" == "-g" ]]; then
    repos=("${(@f)$(ghq list -p)}")
  else
    local gitdir
    gitdir=$(git rev-parse --git-common-dir 2>/dev/null) || {
      echo "cdw: not in a git repository (use -g for all ghq repos)" >&2
      return 1
    }
    repos=("${${gitdir:A}:h}")
  fi
  local target
  target=$(
    for repo in "${repos[@]}"; do
      short="${${repo:h}:t}/${repo:t}"
      git -C "$repo" worktree list --porcelain 2>/dev/null \
        | awk -v r="$short" '
          /^worktree /{wt=$2; next}
          /^branch /{sub(/^refs\/heads\//,"",$2); print r"\t"$2"\t"wt}
          /^detached$/{print r"\t(detached)\t"wt}
        '
    done \
    | awk -F'\t' '
      { rec[NR]=$0; if(length($1)>m1)m1=length($1); if(length($2)>m2)m2=length($2) }
      END {
        for(i=1;i<=NR;i++) {
          split(rec[i],f,"\t")
          printf "%-*s  %-*s  %s\n", m1, f[1], m2, f[2], f[3]
        }
      }' \
    | fzf --nth=1,2 \
    | awk '{print $NF}'
  ) || return
  [[ -d "$target" ]] && builtin cd -- "$target"
}

# just のラッパ: 引数あれば素通し、無ければカレント justfile から fzf で recipe を選んで実行
just() {
  command -v just >/dev/null 2>&1 || { echo "just not found" >&2; return 1; }
  if (( $# > 0 )); then
    command just "$@"
    return
  fi
  local recipe
  recipe=$(command just --list --unsorted 2>/dev/null \
    | tail -n +2 \
    | sed 's/^    //' \
    | fzf \
    | awk '{print $1}') || return
  [[ -z "$recipe" ]] && return
  command just "$recipe"
}
