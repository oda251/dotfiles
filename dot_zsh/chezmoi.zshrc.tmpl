[[ -f "$HOME/.zsh/local.zsh" ]] && source "$HOME/.zsh/local.zsh"

export XDG_CONFIG_HOME="$HOME/.config"

{{- if ne .chezmoi.os "windows" }}
# brew shellenv のキャッシュ
_brew_shellenv_cache() {
  local brew_bin="$1"
  local cache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/brew-shellenv.zsh"
  mkdir -p "${cache:h}"
  if [[ ! -s "$cache" || "$brew_bin" -nt "$cache" ]]; then
    "$brew_bin" shellenv >| "$cache"
  fi
  source "$cache"
}
{{- if eq .chezmoi.os "darwin" }}
[[ -x "/opt/homebrew/bin/brew" ]] && _brew_shellenv_cache "/opt/homebrew/bin/brew"

export WASMER_DIR="$HOME/.wasmer"
[ -s "$WASMER_DIR/wasmer.sh" ] && source "$WASMER_DIR/wasmer.sh"
[[ -d "$HOME/.bun" ]] && fpath=("$HOME/.bun" $fpath)

export PATH="$HOME/.lmstudio/bin:$PATH"
export PATH="$HOME/.antigravity/antigravity/bin:$PATH"
export PATH="$HOME/.amp/bin:$PATH"
export PATH="/Library/Ruby/Gems/2.6.0/bin:$PATH"
{{- else if eq .chezmoi.os "linux" }}
if [[ -d "/home/linuxbrew/.linuxbrew" ]]; then
  _brew_shellenv_cache "/home/linuxbrew/.linuxbrew/bin/brew"
elif [[ -d "$HOME/.linuxbrew" ]]; then
  _brew_shellenv_cache "$HOME/.linuxbrew/bin/brew"
fi
export PATH="$PATH:/usr/local/go/bin:/snap/bin"
export ZELLIJ_AUTO_START="${ZELLIJ_AUTO_START:-true}"
export ZELLIJ_AUTO_EXIT="${ZELLIJ_AUTO_EXIT:-false}"
# WSLg は日本語入力を転送しないため fcitx5 を使う。GUI アプリ用 IME 環境変数。
if [[ -n "${WSL_DISTRO_NAME:-}" ]]; then
  export GTK_IM_MODULE=fcitx
  export QT_IM_MODULE=fcitx
  export XMODIFIERS=@im=fcitx
fi
{{- end }}
unfunction _brew_shellenv_cache
{{- end }}
export PATH="$HOME/.local/bin:$PATH"

export VISUAL="nvim"
export EDITOR="$VISUAL"
export LAZYGIT_EDITOR="$VISUAL"
export FZF_DEFAULT_OPTS="--height 40% --reverse"

# Interactive-only setup (prompt/plugins/aliases)
[[ -o interactive ]] || return 0

HISTFILE="${HOME}/.zsh_history"
HISTSIZE=2000
SAVEHIST=2000
setopt HIST_IGNORE_DUPS HIST_IGNORE_ALL_DUPS HIST_SAVE_NO_DUPS HIST_REDUCE_BLANKS

source "$HOME/.zsh/plugins.zsh"
source "$HOME/.zsh/alias.zsh"
