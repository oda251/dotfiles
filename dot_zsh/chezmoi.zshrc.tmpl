[[ -f "$HOME/.zsh/local.zsh" ]] && source "$HOME/.zsh/local.zsh"

export XDG_CONFIG_HOME="$HOME/.config"

{{- if eq .chezmoi.os "darwin" }}
if [[ -x "/opt/homebrew/bin/brew" ]]; then
  brew_shellenv_cache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/brew-shellenv.zsh"
  mkdir -p "${brew_shellenv_cache:h}"
  if [[ ! -s "$brew_shellenv_cache" || "/opt/homebrew/bin/brew" -nt "$brew_shellenv_cache" ]]; then
    /opt/homebrew/bin/brew shellenv >| "$brew_shellenv_cache"
  fi
  source "$brew_shellenv_cache"
fi

export WASMER_DIR="$HOME/.wasmer"
[ -s "$WASMER_DIR/wasmer.sh" ] && source "$WASMER_DIR/wasmer.sh"
[[ -d "$HOME/.bun" ]] && fpath=("$HOME/.bun" $fpath)

export PATH="$HOME/.lmstudio/bin:$PATH"
export PATH="$HOME/.antigravity/antigravity/bin:$PATH"
export PATH="$HOME/.amp/bin:$PATH"
export PATH="/Library/Ruby/Gems/2.6.0/bin:$PATH"
{{- else if eq .chezmoi.os "linux" }}
if [[ -d "/home/linuxbrew/.linuxbrew" ]]; then
  brew_shellenv_cache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/brew-shellenv.zsh"
  mkdir -p "${brew_shellenv_cache:h}"
  if [[ ! -s "$brew_shellenv_cache" || "/home/linuxbrew/.linuxbrew/bin/brew" -nt "$brew_shellenv_cache" ]]; then
    /home/linuxbrew/.linuxbrew/bin/brew shellenv >| "$brew_shellenv_cache"
  fi
  source "$brew_shellenv_cache"
elif [[ -d "$HOME/.linuxbrew" ]]; then
  brew_shellenv_cache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/brew-shellenv.zsh"
  mkdir -p "${brew_shellenv_cache:h}"
  if [[ ! -s "$brew_shellenv_cache" || "$HOME/.linuxbrew/bin/brew" -nt "$brew_shellenv_cache" ]]; then
    "$HOME/.linuxbrew/bin/brew" shellenv >| "$brew_shellenv_cache"
  fi
  source "$brew_shellenv_cache"
fi
export PATH="$PATH:/usr/local/go/bin"
export ZELLIJ_AUTO_START="${ZELLIJ_AUTO_START:-true}"
export ZELLIJ_AUTO_ATTACH="${ZELLIJ_AUTO_ATTACH:-true}"
export ZELLIJ_AUTO_EXIT="${ZELLIJ_AUTO_EXIT:-false}"
{{- else if eq .chezmoi.os "windows" }}
# Windows: brew/nix は不使用、mise は plugins.zsh で activate
{{- end }}
export PATH="$HOME/.local/bin:$PATH"

export VISUAL="nvim"
export EDITOR="$VISUAL"
export LAZYGIT_EDITOR="$VISUAL"

# Interactive-only setup (prompt/plugins/aliases)
[[ -o interactive ]] || return 0

HISTSIZE=2000
SAVEHIST=2000
setopt HIST_IGNORE_DUPS HIST_IGNORE_ALL_DUPS HIST_SAVE_NO_DUPS HIST_REDUCE_BLANKS

source "$HOME/.zsh/plugins.zsh"
source "$HOME/.zsh/alias.zsh"
