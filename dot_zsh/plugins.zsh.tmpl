source_cache_script() {
  local script_path="$1"
  local compiled_path="${script_path}.zwc"

  # Source the original script so zsh can pick script.zwc automatically.
  source "$script_path"
  if [[ -s "$script_path" && ( ! -e "$compiled_path" || "$script_path" -nt "$compiled_path" ) ]]; then
    zcompile "$script_path" 2>/dev/null
  fi
}

if command -v mise >/dev/null 2>&1; then
  mise_bin="$(command -v mise)"
  mise_init_cache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/mise-activate.zsh"
  mkdir -p "${mise_init_cache:h}"
  if [[ ! -s "$mise_init_cache" || "$mise_bin" -nt "$mise_init_cache" ]]; then
    "$mise_bin" activate zsh >| "$mise_init_cache"
    rm -f "${mise_init_cache}.zwc"
  fi
  source_cache_script "$mise_init_cache"

  # activate は遅延読み込みのため、即座に必要なツール（deno 等）のパスを先に追加
  eval "$("$mise_bin" env -s zsh 2>/dev/null)"
fi

{{- if ne .chezmoi.os "windows" }}

{{- if eq .chezmoi.os "darwin" }}
_brew_prefix="/opt/homebrew"
{{- else }}
if [[ -d "/home/linuxbrew/.linuxbrew" ]]; then
  _brew_prefix="/home/linuxbrew/.linuxbrew"
else
  _brew_prefix="$HOME/.linuxbrew"
fi
{{- end }}

# 補完スクリプトの生成・キャッシュ
_completion_cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/completions"
mkdir -p "$_completion_cache_dir"
if command -v chezmoi >/dev/null 2>&1; then
  if [[ ! -s "$_completion_cache_dir/_chezmoi" || "$(command -v chezmoi)" -nt "$_completion_cache_dir/_chezmoi" ]]; then
    chezmoi completion zsh >| "$_completion_cache_dir/_chezmoi"
  fi
fi
fpath=( "$_completion_cache_dir" $fpath )
autoload -Uz compinit
if [[ -n ~/.zcompdump(#qN.mh+24) ]]; then
  compinit
else
  compinit -C
fi

# fzf-tab（Tab 補完を fzf でインタラクティブにする）
_fzf_tab_dir="${HOME}/.zsh/fzf-tab"
if [[ ! -d "$_fzf_tab_dir" ]]; then
  git clone https://github.com/Aloxaf/fzf-tab.git "$_fzf_tab_dir"
fi
if [[ -f "$_fzf_tab_dir/fzf-tab.plugin.zsh" ]]; then
  source "$_fzf_tab_dir/fzf-tab.plugin.zsh"
fi
zstyle ':fzf-tab:*' fzf-bindings 'space:accept' 'right:accept' 'enter:accept'
zstyle ':fzf-tab:*' accept-line enter

# zeno.zsh（Deno + fzf ベースのスニペット・特定コマンド補完）
_zeno_dir="${HOME}/.zsh/zeno.zsh"
if [[ ! -d "$_zeno_dir" ]]; then
  git clone https://github.com/yuki-yano/zeno.zsh.git "$_zeno_dir"
fi

export ZENO_HOME="$_zeno_dir"
export ZENO_ENABLE_SOCK=1
export ZENO_GIT_CAT="bat --color=always"
export ZENO_GIT_TREE="eza --tree"

if [[ -f "$_zeno_dir/zeno.zsh" ]]; then
  source "$_zeno_dir/zeno.zsh"
fi

# zeno のフォールバックを fzf-tab に設定
export ZENO_COMPLETION_FALLBACK=fzf-tab-complete

# Tab: zeno 補完（パターン未マッチ時は fzf-tab にフォールバック）
bindkey '\t' zeno-completion

# Ctrl-R: zeno 履歴検索
bindkey '^r' zeno-history-selection

# スペース / Enter: スニペット自動展開
bindkey ' '  zeno-auto-snippet
bindkey '^m' zeno-auto-snippet-and-accept-line

# Ctrl-X + s: スニペット挿入
bindkey '^x^s' zeno-insert-snippet

# Ctrl-X + Ctrl-G: ghq リポジトリ移動
bindkey '^x^g' zeno-ghq-cd

# Windows 由来の不要な拡張子をコマンド補完から除外
zstyle ':completion:*:*:*:*' ignored-patterns '*.dll' '*.dat' '*.exe'

# 常時履歴リスト表示
source "$HOME/.zsh/history-list.zsh"

bindkey '^P' __hl_up
bindkey '^N' __hl_down

# zsh-syntax-highlighting（最後に読み込む）
if [[ -f "$_brew_prefix/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
  source "$_brew_prefix/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi
{{- end }}

# zoxide and starship - installed via mise on all platforms
if command -v zoxide >/dev/null 2>&1; then
  zoxide_bin="$(command -v zoxide)"
  zoxide_init_cache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zoxide-init.zsh"
  mkdir -p "${zoxide_init_cache:h}"
  if [[ ! -s "$zoxide_init_cache" || "$zoxide_bin" -nt "$zoxide_init_cache" ]]; then
    "$zoxide_bin" init zsh >| "$zoxide_init_cache"
  fi
  source_cache_script "$zoxide_init_cache"
fi

if command -v starship >/dev/null 2>&1; then
  starship_bin="$(command -v starship)"
  starship_init_cache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/starship-init.zsh"
  mkdir -p "${starship_init_cache:h}"
  if [[ ! -s "$starship_init_cache" || "$starship_bin" -nt "$starship_init_cache" ]]; then
    "$starship_bin" init zsh >| "$starship_init_cache"
  fi
  source_cache_script "$starship_init_cache"
fi

if command -v zsh >/dev/null 2>&1; then
  export SHELL="$(command -v zsh)"
fi

# OSC 7: ターミナルに CWD を通知（Zellij のペイン/タブ CWD 引き継ぎに必要）
__notify_terminal_cwd() {
  printf '\e]7;file://%s%s\e\\' "${HOST}" "${PWD}"
}
autoload -Uz add-zsh-hook
add-zsh-hook chpwd __notify_terminal_cwd
__notify_terminal_cwd

if [[ "${ZELLIJ_AUTO_START:-false}" == "true" && -z "$ZELLIJ" && -o interactive && -t 0 && -t 1 ]] && command -v zellij >/dev/null 2>&1; then
    zellij attach -c main

    if [[ "$ZELLIJ_AUTO_EXIT" == "true" ]]; then
        exit
    fi
fi
