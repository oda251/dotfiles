{{- if ne .chezmoi.os "windows" }}
# zsh plugins - sourced from brew
zstyle ':autocomplete:*' default-context history-incremental-search-backward
zstyle ':autocomplete:history-incremental-search-backward:*' list-lines 8
zstyle ':autocomplete:history-search-backward:*' list-lines 8
zstyle ':autocomplete::compinit' arguments -C

{{- if eq .chezmoi.os "darwin" }}
_brew_prefix="/opt/homebrew"
{{- else }}
if [[ -d "/home/linuxbrew/.linuxbrew" ]]; then
  _brew_prefix="/home/linuxbrew/.linuxbrew"
else
  _brew_prefix="$HOME/.linuxbrew"
fi
{{- end }}

if [[ -f "$_brew_prefix/share/zsh-autocomplete/zsh-autocomplete.plugin.zsh" ]]; then
  source "$_brew_prefix/share/zsh-autocomplete/zsh-autocomplete.plugin.zsh"
fi

# Tab: autocomplete の表示をクリアしてから標準補完を実行
zle -C __tab_complete_impl menu-select _main_complete
__tab_complete() {
  RBUFFER=""
  zle -Rc
  zle __tab_complete_impl
}
zle -N __tab_complete
bindkey '\t' __tab_complete
bindkey -M menuselect '\t' down-line-or-history
bindkey -M menuselect '^M' .accept-line
bindkey -M menuselect '^J' .accept-line
bindkey -M menuselect '^[[D' backward-char
bindkey -M menuselect '^[[C' forward-char

# 上下矢印: 履歴の前方一致検索
bindkey '\e[A'  history-search-backward
bindkey '\eOA'  history-search-backward
bindkey '\e[B'  history-search-forward
bindkey '\eOB'  history-search-forward
bindkey '^P'    history-search-backward
bindkey '^N'    history-search-forward

() {
  autoload +X _autocomplete__history_lines 2>/dev/null || return
  eval "$(functions _autocomplete__history_lines | command sed "s/suf=([^)]*_autocomplete__history_lines_suffix[^)]*)/suf=( -qS ' ' )/")"
}


if [[ -f "$_brew_prefix/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
  source "$_brew_prefix/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi
{{- end }}

source_cache_script() {
  local script_path="$1"
  local compiled_path="${script_path}.zwc"

  # Source the original script so zsh can pick script.zwc automatically.
  source "$script_path"
  if [[ -s "$script_path" && ( ! -e "$compiled_path" || "$script_path" -nt "$compiled_path" ) ]]; then
    zcompile "$script_path" 2>/dev/null
  fi
}

# mise is used on all platforms (CLI tools only on Windows)
if command -v mise >/dev/null 2>&1; then
  mise_bin="$(command -v mise)"
  mise_init_cache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/mise-activate.zsh"
  mkdir -p "${mise_init_cache:h}"
  if [[ ! -s "$mise_init_cache" || "$mise_bin" -nt "$mise_init_cache" ]]; then
    "$mise_bin" activate zsh >| "$mise_init_cache"
    rm -f "${mise_init_cache}.zwc"
  fi
  source_cache_script "$mise_init_cache"
fi

# zoxide and starship - installed via mise on all platforms
if command -v zoxide >/dev/null 2>&1; then
  zoxide_bin="$(command -v zoxide)"
  zoxide_init_cache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zoxide-init.zsh"
  mkdir -p "${zoxide_init_cache:h}"
  if [[ ! -s "$zoxide_init_cache" || "$zoxide_bin" -nt "$zoxide_init_cache" ]]; then
    "$zoxide_bin" init zsh >| "$zoxide_init_cache"
  fi
  source_cache_script "$zoxide_init_cache"
fi

if command -v starship >/dev/null 2>&1; then
  starship_bin="$(command -v starship)"
  starship_init_cache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/starship-init.zsh"
  mkdir -p "${starship_init_cache:h}"
  if [[ ! -s "$starship_init_cache" || "$starship_bin" -nt "$starship_init_cache" ]]; then
    "$starship_bin" init zsh >| "$starship_init_cache"
  fi
  source_cache_script "$starship_init_cache"
fi

if command -v zsh >/dev/null 2>&1; then
  export SHELL="$(command -v zsh)"
fi

# OSC 7: ターミナルに CWD を通知（Zellij のペイン/タブ CWD 引き継ぎに必要）
__notify_terminal_cwd() {
  printf '\e]7;file://%s%s\e\\' "${HOST}" "${PWD}"
}
autoload -Uz add-zsh-hook
add-zsh-hook chpwd __notify_terminal_cwd
__notify_terminal_cwd

if [[ "${ZELLIJ_AUTO_START:-false}" == "true" && -z "$ZELLIJ" && -o interactive && -t 0 && -t 1 ]] && command -v zellij >/dev/null 2>&1; then
    zellij attach -c main

    if [[ "$ZELLIJ_AUTO_EXIT" == "true" ]]; then
        exit
    fi
fi
