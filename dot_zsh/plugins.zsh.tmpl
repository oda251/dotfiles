source_cache_script() {
  local script_path="$1"
  local compiled_path="${script_path}.zwc"

  source "$script_path"
  if [[ -s "$script_path" && ( ! -e "$compiled_path" || "$script_path" -nt "$compiled_path" ) ]]; then
    zcompile "$script_path" 2>/dev/null
  fi
}

# コマンドの init スクリプトをキャッシュして source する
# 使い方: _init_tool_cache <コマンド名> <init サブコマンド...>
_init_tool_cache() {
  local tool_name="$1"
  shift
  local bin_path
  bin_path="$(command -v "$tool_name")" || return 1

  local cache_file="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/${tool_name}-init.zsh"
  mkdir -p "${cache_file:h}"
  if [[ ! -s "$cache_file" || "$bin_path" -nt "$cache_file" ]]; then
    "$bin_path" "$@" >| "$cache_file"
    rm -f "${cache_file}.zwc"
  fi
  source_cache_script "$cache_file"
}

if _init_tool_cache mise activate zsh; then
  # activate は遅延読み込みのため、即座に必要なツールのパスを先に追加
  local mise_env_cache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/mise-env.zsh"
  local mise_global_config="${XDG_CONFIG_HOME:-$HOME/.config}/mise/config.toml"
  if [[ ! -s "$mise_env_cache" \
        || ( -f "$mise_global_config" && "$mise_global_config" -nt "$mise_env_cache" ) \
        || "$(command -v mise)" -nt "$mise_env_cache" ]]; then
    mise env -s zsh >| "$mise_env_cache" 2>/dev/null
    rm -f "${mise_env_cache}.zwc"
  fi
  source_cache_script "$mise_env_cache"
fi

