source_cache_script() {
  local script_path="$1"
  local compiled_path="${script_path}.zwc"

  source "$script_path"
  if [[ -s "$script_path" && ( ! -e "$compiled_path" || "$script_path" -nt "$compiled_path" ) ]]; then
    zcompile "$script_path" 2>/dev/null
  fi
}

# cache 生成時に呼び出し元 PATH から /mnt/* を除く。
# 過去 28 個の Windows パスがキャッシュに焼き込まれて永続化した事故対策。
_path_without_wsl_mounts() {
  local -a parts=(${(s.:.)PATH})
  parts=(${parts:#/mnt/*})
  print -r -- "${(j.:.)parts}"
}

# コマンドの init スクリプトをキャッシュして source する
# 使い方: _init_tool_cache <コマンド名> <init サブコマンド...>
_init_tool_cache() {
  local tool_name="$1"
  shift
  local bin_path
  bin_path="$(command -v "$tool_name")" || return 1
  # mise upgrade 等でバージョンが変わると、生成済み init が旧バージョンの絶対パスを
  # 焼き込んだまま残り、旧 install ディレクトリ削除後に "見つからない" 状態になる。
  # command -v の mtime だけでなく、シンボリックリンク (mise の latest 等) を実体解決した
  # パスを stamp として記録し、解決先が変わった/消えた場合も再生成する。
  local real_path="${bin_path:A}"
  local stamp="# tool-path: ${real_path}"

  local cache_file="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/${tool_name}-init.zsh"
  mkdir -p "${cache_file:h}"
  local first=""
  [[ -s "$cache_file" ]] && read -r first < "$cache_file"
  if [[ ! -s "$cache_file" || "$real_path" -nt "$cache_file" || "$first" != "$stamp" ]]; then
    { print -r -- "$stamp"; PATH="$(_path_without_wsl_mounts)" "$bin_path" "$@" } >| "$cache_file"
    rm -f "${cache_file}.zwc"
  fi
  source_cache_script "$cache_file"
}

if _init_tool_cache mise activate zsh; then
  # activate は遅延読み込みのため、即座に必要なツールのパスを先に追加
  local mise_env_cache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/mise-env.zsh"
  local mise_global_config="${XDG_CONFIG_HOME:-$HOME/.config}/mise/config.toml"
  if [[ ! -s "$mise_env_cache" \
        || ( -f "$mise_global_config" && "$mise_global_config" -nt "$mise_env_cache" ) \
        || "$(command -v mise)" -nt "$mise_env_cache" ]]; then
    PATH="$(_path_without_wsl_mounts)" mise env -s zsh >| "$mise_env_cache" 2>/dev/null
    rm -f "${mise_env_cache}.zwc"
  fi
  source_cache_script "$mise_env_cache"
fi

# WSL: wsl.exe / clip.exe 等の interop バイナリ用に Windows System32 を追加。
# mise-env は PATH を上書きする & __MISE_ORIG_PATH も上書き先になるため、
# mise の後で append し、precmd の hook-env でも消えないよう __MISE_ORIG_PATH にも反映する。
if [[ -n "${WSL_DISTRO_NAME:-}" ]] && [[ ":$PATH:" != *":/mnt/c/Windows/System32:"* ]]; then
  export PATH="$PATH:/mnt/c/Windows/System32"
  if [[ -n "${__MISE_ORIG_PATH:-}" && ":$__MISE_ORIG_PATH:" != *":/mnt/c/Windows/System32:"* ]]; then
    export __MISE_ORIG_PATH="$__MISE_ORIG_PATH:/mnt/c/Windows/System32"
  fi
fi

{{- if ne .chezmoi.os "windows" }}

{{- if eq .chezmoi.os "darwin" }}
_brew_prefix="/opt/homebrew"
{{- else }}
if [[ -d "/home/linuxbrew/.linuxbrew" ]]; then
  _brew_prefix="/home/linuxbrew/.linuxbrew"
