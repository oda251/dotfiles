# 補完スクリプトの生成・キャッシュ
_completion_cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/completions"
mkdir -p "$_completion_cache_dir"

_cache_completion() {
  local cmd="$1" subcmd="${2:-completion zsh}"
  local bin_path cache_file
  bin_path="$(command -v "$cmd")" || return 1
  cache_file="$_completion_cache_dir/_${cmd}"
  if [[ ! -s "$cache_file" || "$bin_path" -nt "$cache_file" ]]; then
    eval "$cmd $subcmd" >| "$cache_file" 2>/dev/null
  fi
}

_cache_completion chezmoi "completion zsh"
_cache_completion gh "completion -s zsh"
_cache_completion mise "completion zsh"
_cache_completion docker "completion zsh"
fpath=( "$_completion_cache_dir" $fpath )
autoload -Uz compinit
if [[ -n ~/.zcompdump(#qN.mh+24) ]]; then
  compinit
  { zcompile ~/.zcompdump } &!
else
  compinit -C
fi

# 専用補完関数が未定義のコマンドに対して --help から -option / --option を抽出
# _gnu_generic は --long-option のみ対応のため、-single-dash も拾うカスタム版を使用
_help_generic() {
  local bin_path
  bin_path="$(command -v "${words[1]}")" || return 1
  local raw_key="${words[1]:t}_${(j:_:)words[2,-1]}"
  local cache_file="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/help-generic/${raw_key//[^a-zA-Z0-9._-]/_}"
  if [[ ! -s "$cache_file" || "$bin_path" -nt "$cache_file" ]]; then
    mkdir -p "${cache_file:h}"
    local help_output
    help_output="$("${words[1]}" "${(@)words[2,-1]}" --help 2>&1)"
    [[ -n "$help_output" ]] || return 1
    command grep -oE '(^|[[:space:]])-{1,2}[a-zA-Z][-a-zA-Z0-9]*=?' <<< "$help_output" \
      | sed 's/^[[:space:]]*//' | sort -u >| "$cache_file"
  fi
  local -a opts=(${(f)"$(<"$cache_file")"})
  local -a eq_opts=(${(M)opts:#*=}) bare_opts=(${opts:#*=})
  (( ${#eq_opts} )) && _describe 'option' eq_opts -S ''
  (( ${#bare_opts} )) && _describe 'option' bare_opts
  _default
}
compdef _help_generic -default-

# fzf-tab（Tab 補完を fzf でインタラクティブにする）
_fzf_tab_dir="${HOME}/.zsh/fzf-tab"
if [[ ! -d "$_fzf_tab_dir" ]]; then
  git clone https://github.com/Aloxaf/fzf-tab.git "$_fzf_tab_dir"
fi
if [[ -f "$_fzf_tab_dir/fzf-tab.plugin.zsh" ]]; then
  source "$_fzf_tab_dir/fzf-tab.plugin.zsh"
fi
zstyle ':fzf-tab:*' fzf-bindings 'space:accept' 'right:accept' 'enter:accept'
zstyle ':fzf-tab:*' accept-line enter

# パターンマッチ fzf 補完（fzf-tab の後に source し、^I をラップ）
source "$HOME/.zsh/fzf-completion.zsh"

# Windows 由来の不要な拡張子をコマンド補完から除外
zstyle ':completion:*:*:*:*' ignored-patterns '*.dll' '*.dat' '*.exe'

# 常時履歴リスト表示
source "$HOME/.zsh/history-list.zsh"

bindkey '^P' __hl_up
bindkey '^N' __hl_down

# zsh-syntax-highlighting（最後に読み込む）
if [[ -f "$_brew_prefix/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
  source "$_brew_prefix/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi
{{- end }}

_init_tool_cache direnv hook zsh
_init_tool_cache zoxide init zsh
_init_tool_cache starship init zsh

if command -v zsh >/dev/null 2>&1; then
  export SHELL="$(command -v zsh)"
fi

# OSC 7: ターミナルに CWD を通知（Zellij のペイン/タブ CWD 引き継ぎに必要）
__notify_terminal_cwd() {
  printf '\e]7;file://%s%s\e\\' "${HOST}" "${PWD}"
}
autoload -Uz add-zsh-hook
add-zsh-hook chpwd __notify_terminal_cwd
__notify_terminal_cwd

if [[ "${ZELLIJ_AUTO_START:-false}" == "true" && -z "$ZELLIJ" && -o interactive && -t 0 && -t 1 ]] && command -v zellij >/dev/null 2>&1; then
    zellij attach -c main

    if [[ "$ZELLIJ_AUTO_EXIT" == "true" ]]; then
        exit
    fi
fi
