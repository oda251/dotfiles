{{- if ne .chezmoi.os "windows" }}
# zsh plugins are managed by nix; source from nix profile
if [[ -f "$HOME/.nix-profile/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
  source "$HOME/.nix-profile/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
elif [[ -f "/nix/var/nix/profiles/per-user/$USER/profile/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
  source "/nix/var/nix/profiles/per-user/$USER/profile/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi

if [[ -f "$HOME/.nix-profile/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
  source "$HOME/.nix-profile/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
elif [[ -f "/nix/var/nix/profiles/per-user/$USER/profile/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
  source "/nix/var/nix/profiles/per-user/$USER/profile/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi

eval "$(mise activate zsh)"
eval "$(zoxide init zsh)"
eval "$(starship init zsh)"
{{- else }}
# Windows: starship and zoxide need to be installed separately (e.g., via winget or scoop)
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"
command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"
{{- end }}

if command -v zsh >/dev/null 2>&1; then
  export SHELL="$(command -v zsh)"
fi

if [[ -z "$ZELLIJ" ]]; then
    if [[ "$ZELLIJ_AUTO_ATTACH" == "true" ]]; then
        zellij attach -c || zellij
    else
        zellij
    fi

    if [[ "$ZELLIJ_AUTO_EXIT" == "true" ]]; then
        exit
    fi
fi
