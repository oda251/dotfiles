{{- if lookPath "infisical" -}}
#!/bin/bash
if ! infisical secrets get NEWRELIC_LICENSE_KEY --plain --silent --env prod --path /generated >/dev/null 2>&1; then
  echo ""
  echo "⚠ Infisical にログインしていません。"
  echo "  一部の設定（OTEL等）が反映されません。"
  echo "  → infisical login && infisical init を実行してください。"
  echo ""
fi
{{ end -}}
