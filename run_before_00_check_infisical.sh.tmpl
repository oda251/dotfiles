#!/bin/bash
{{- if lookPath "infisical" }}
CHEZMOI_SOURCE="{{ .chezmoi.sourceDir }}"

if ! infisical user get token --silent >/dev/null 2>&1; then
  echo ""
  echo "=== Infisical ログイン ==="
  (cd "${CHEZMOI_SOURCE}" && infisical login)
fi

if [[ ! -f "${CHEZMOI_SOURCE}/.infisical.json" ]]; then
  echo ""
  echo "=== Infisical プロジェクト選択 ==="
  (cd "${CHEZMOI_SOURCE}" && infisical init)
fi
{{ end -}}
