{{ if eq .chezmoi.os "windows" -}}
$ErrorActionPreference = "Stop"

# mise config hash: {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }}

function Get-MisePath {
    $cmd = Get-Command mise -ErrorAction SilentlyContinue
    if ($cmd) {
        return $cmd.Source
    }

    $candidates = @(
        "$env:LOCALAPPDATA\Microsoft\WinGet\Links\mise.exe",
        "$env:LOCALAPPDATA\Microsoft\WindowsApps\mise.exe",
        "$env:USERPROFILE\.local\bin\mise.exe",
        "$env:USERPROFILE\scoop\shims\mise.exe"
    )

    foreach ($path in $candidates) {
        if (Test-Path $path) {
            return $path
        }
    }

    return $null
}

$mise = Get-MisePath
if (-not $mise) {
    if (Get-Command winget -ErrorAction SilentlyContinue) {
        Write-Host "mise not found. Installing with winget..."
        & winget install --id jdx.mise --exact --accept-source-agreements --accept-package-agreements
        # winget updates user PATH, but current process does not always inherit it.
        $userPath = [Environment]::GetEnvironmentVariable("Path", "User")
        if ($userPath) {
            $env:Path = "$env:Path;$userPath"
        }
        $mise = Get-MisePath
    }
}

if (-not $mise) {
    Write-Warning "mise not found; skip tool installation"
    exit 0
}

Write-Host "Installing mise tools..."
& $mise install

if (Get-Command ya -ErrorAction SilentlyContinue) {
    $yaHelp = & ya --help 2>$null
    if ($LASTEXITCODE -eq 0 -and $yaHelp -match "\bpkg\b") {
        & ya pkg install
        if ($LASTEXITCODE -ne 0) {
            Write-Warning "ya pkg failed; skip yazi plugins"
        }
    } else {
        Write-Warning "ya pkg not supported; update yazi to use plugins"
    }
} else {
    Write-Warning "ya not found; skip yazi plugins"
}
{{ end -}}
