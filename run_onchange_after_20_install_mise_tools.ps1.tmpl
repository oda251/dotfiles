{{ if eq .chezmoi.os "windows" -}}
$ErrorActionPreference = "Stop"

# mise config hash: {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }}

Write-Host "Installing mise tools..."
mise install

if (Get-Command ya -ErrorAction SilentlyContinue) {
    $yaHelp = & ya --help 2>$null
    if ($LASTEXITCODE -eq 0 -and $yaHelp -match "\bpkg\b") {
        & ya pkg install
        if ($LASTEXITCODE -ne 0) {
            Write-Warning "ya pkg failed; skip yazi plugins"
        }
    } else {
        Write-Warning "ya pkg not supported; update yazi to use plugins"
    }
} else {
    Write-Warning "ya not found; skip yazi plugins"
}
{{ end -}}
