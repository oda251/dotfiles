{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
set -euo pipefail

packages=(gcc g++ unzip fontconfig zsh libasound2-dev pkg-config libx11-dev libxrandr-dev libxi-dev libgl1-mesa-dev libxcursor-dev libxkbcommon-dev libgtk-3-dev libnspr4 libnss3 fonts-noto-color-emoji inotify-tools fcitx5 fcitx5-mozc)
missing=()

for pkg in "${packages[@]}"; do
  if ! dpkg -s "$pkg" &>/dev/null; then
    missing+=("$pkg")
  fi
done

if [[ ${#missing[@]} -gt 0 ]]; then
  sudo apt-get update -qq
  sudo apt-get install -y -qq "${missing[@]}"
fi

# Obsidian (deb, snap版はWSLで動かない)
if ! dpkg -s obsidian &>/dev/null; then
  obsidian_version="1.12.7"
  wget -q "https://github.com/obsidianmd/obsidian-releases/releases/download/v${obsidian_version}/obsidian_${obsidian_version}_amd64.deb" -O /tmp/obsidian.deb
  sudo apt-get install -y /tmp/obsidian.deb
  rm -f /tmp/obsidian.deb
fi

# WSL: symlink win32yank.exe for Neovim clipboard
win32yank_src="/mnt/c/Users/odada/AppData/Local/Microsoft/WinGet/Packages/equalsraf.win32yank_Microsoft.Winget.Source_8wekyb3d8bbwe/win32yank.exe"
if [[ -f "$win32yank_src" ]]; then
  sudo ln -sf "$win32yank_src" /usr/local/bin/win32yank.exe
fi
{{- end }}
