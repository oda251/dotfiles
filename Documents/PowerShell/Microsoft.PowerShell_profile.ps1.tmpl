# PowerShell Profile for Windows
# This profile is managed by chezmoi

# Environment variables
$env:XDG_CONFIG_HOME = "$HOME\.config"

# Add local bin to PATH
$env:PATH = "$HOME\.local\bin;$env:PATH"

# Initialize mise (shims mode for fast startup)
$env:MISE_SHELL = "pwsh"
$env:PATH = "$HOME\AppData\Local\mise\shims;$env:PATH"

# Initialize tools from cache (auto-regenerates when binary changes)
$_cacheDir = "$HOME\.cache\powershell"

function _InitToolCache {
    param([string]$Name, [string[]]$InitArgs)
    $bin = Get-Command $Name -ErrorAction SilentlyContinue
    if (-not $bin) { return }
    $binPath = $bin.Source
    $cacheFile = "$_cacheDir\${Name}-init.ps1"
    if ((-not (Test-Path $cacheFile)) -or
        ((Get-Item $binPath).LastWriteTime -gt (Get-Item $cacheFile).LastWriteTime)) {
        New-Item -ItemType Directory -Path $_cacheDir -Force | Out-Null
        & $binPath @InitArgs | Out-File $cacheFile -Encoding utf8
    }
    . $cacheFile
}

_InitToolCache zoxide @('init', 'powershell')
_InitToolCache starship @('init', 'powershell', '--print-full-init')

# Source local PowerShell config if it exists
$LocalProfile = "$HOME\.config\powershell\local.ps1"
if (Test-Path $LocalProfile) {
    . $LocalProfile
}

# Clipboard helper for PowerShell/Windows
function copy {
    [CmdletBinding()]
    param(
        [Parameter(ValueFromRemainingArguments = $true)]
        [string[]]$Text
    )

    if ($input) {
        $input | Set-Clipboard
        return
    }

    if ($Text -and $Text.Count -gt 0) {
        ($Text -join " ") | Set-Clipboard
        return
    }

    Write-Warning "No input to copy"
}

function y {
    $tmp = New-TemporaryFile
    try {
        yazi @args --cwd-file $tmp.FullName
        if (Test-Path $tmp.FullName) {
            $cwd = Get-Content $tmp.FullName -Raw
            if ($cwd -and $cwd -ne (Get-Location).Path) {
                Set-Location $cwd
            }
        }
    } finally {
        if (Test-Path $tmp.FullName) {
            Remove-Item $tmp.FullName -Force
        }
    }
}

# Aliases
Set-Alias -Name lg -Value lazygit
Remove-Alias -Name ls -Force -ErrorAction SilentlyContinue
function ls { eza --icons @args }
function ll { eza --icons -la @args }
function now { Get-Date -Format "yyyyMMddHHmmss" }

# PSReadLine configuration (built-in to pwsh 7+)
Set-PSReadLineOption -PredictionSource History -ErrorAction SilentlyContinue
Set-PSReadLineOption -PredictionViewStyle ListView -ErrorAction SilentlyContinue
Set-PSReadLineOption -EditMode Emacs
Set-PSReadLineKeyHandler -Key Tab -Function MenuComplete
