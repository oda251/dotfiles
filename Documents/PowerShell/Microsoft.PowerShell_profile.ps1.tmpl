# PowerShell Profile for Windows
# This profile is managed by chezmoi

# Environment variables
$env:XDG_CONFIG_HOME = "$HOME\.config"
$env:VISUAL = "nvim"
$env:EDITOR = $env:VISUAL
$env:LAZYGIT_EDITOR = $env:VISUAL

# Add local bin to PATH
$env:PATH = "$HOME\.local\bin;$env:PATH"

# Initialize mise (mise が管理するツールを PATH に追加)
if (Get-Command mise -ErrorAction SilentlyContinue) {
    Invoke-Expression (& { (mise activate powershell | Out-String) })
}

# Initialize zoxide (smart cd)
if (Get-Command zoxide -ErrorAction SilentlyContinue) {
    Invoke-Expression (& { (zoxide init powershell | Out-String) })
}

# Initialize starship prompt
if (Get-Command starship -ErrorAction SilentlyContinue) {
    Invoke-Expression (&starship init powershell)
}

# Source local PowerShell config if it exists
$LocalProfile = "$HOME\.config\powershell\local.ps1"
if (Test-Path $LocalProfile) {
    . $LocalProfile
}

# Clipboard helper for PowerShell/Windows
function copy {
    [CmdletBinding()]
    param(
        [Parameter(ValueFromRemainingArguments = $true)]
        [string[]]$Text
    )

    if ($input) {
        $input | Set-Clipboard
        return
    }

    if ($Text -and $Text.Count -gt 0) {
        ($Text -join " ") | Set-Clipboard
        return
    }

    Write-Warning "No input to copy"
}

function y {
    $tmp = New-TemporaryFile
    try {
        yazi @args --cwd-file $tmp.FullName
        if (Test-Path $tmp.FullName) {
            $cwd = Get-Content $tmp.FullName -Raw
            if ($cwd -and $cwd -ne (Get-Location).Path) {
                Set-Location $cwd
            }
        }
    } finally {
        if (Test-Path $tmp.FullName) {
            Remove-Item $tmp.FullName -Force
        }
    }
}

# PSReadLine configuration for better command line editing
if (Get-Module -ListAvailable -Name PSReadLine) {
    Import-Module PSReadLine
    Set-PSReadLineOption -PredictionSource History
    Set-PSReadLineOption -PredictionViewStyle ListView
    Set-PSReadLineOption -EditMode Emacs
    Set-PSReadLineKeyHandler -Key Tab -Function MenuComplete
}
