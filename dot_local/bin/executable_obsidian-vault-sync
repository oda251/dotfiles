#!/usr/bin/env bash
set -euo pipefail

VAULT="${OBSIDIAN_VAULT_DIR:-$HOME/obsidian-vault}"

if [[ ! -d "$VAULT/.git" ]]; then
  echo "obsidian-vault-sync: $VAULT is not a git repo, skipping" >&2
  exit 0
fi

cd "$VAULT"

if ! git pull --rebase --autostash; then
  # Clean up any half-applied rebase so next run isn't wedged.
  git rebase --abort 2>/dev/null || true
  git stash pop 2>/dev/null || true
  echo "obsidian-vault-sync: pull failed; aborted rebase, will retry next tick" >&2
  exit 0
fi

if [[ -n "$(git status --porcelain)" ]]; then
  git add -A
  git commit -m "auto: $(hostname) $(date -Iseconds)"
fi

git push
