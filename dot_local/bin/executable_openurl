#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 || -z "${1:-}" ]]; then
  printf 'Usage: openurl <http(s)-URL>\n' >&2
  exit 2
fi

url=$1
case "$url" in
  http://*|https://*) ;;
  *)
    printf 'openurl: only http:// and https:// URLs are supported\n' >&2
    exit 2
    ;;
esac

if [[ "$url" == *$'\r'* || "$url" == *$'\n'* ]]; then
  printf 'openurl: URL must not contain line breaks\n' >&2
  exit 2
fi

if command -v powershell.exe >/dev/null 2>&1; then
  powershell="$(command -v powershell.exe)"
elif [[ -x /mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe ]]; then
  powershell=/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe
else
  printf 'openurl: powershell.exe is unavailable; run this from WSL with Windows interop enabled\n' >&2
  exit 1
fi

printf '%s' "$url" | "$powershell" -NoProfile -NonInteractive -Command '
$url = [Console]::In.ReadToEnd()
Start-Process -FilePath $url
'
