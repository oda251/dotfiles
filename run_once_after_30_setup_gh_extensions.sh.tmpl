#!/bin/bash

{{ template "setup-brew-env.sh" . }}
{{ template "setup-mise-env.sh" . }}

if ! command -v gh >/dev/null 2>&1; then
  if command -v mise >/dev/null 2>&1; then
    mise install gh
    eval "$(mise activate bash)"
  elif command -v brew >/dev/null 2>&1; then
    brew install gh
  fi
fi

if ! command -v gh >/dev/null 2>&1; then
  echo "gh not found; install it before setting up extensions" >&2
  exit 0
fi

if ! gh auth status &>/dev/null; then
  echo "gh not authenticated; run 'gh auth login' before setting up extensions" >&2
  exit 0
fi

if ! gh extension list | grep -q 'gh-dash'; then
    gh extension install dlvhdr/gh-dash
fi
