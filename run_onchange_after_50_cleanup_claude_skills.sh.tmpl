#!/usr/bin/env bash
set -euo pipefail

# Trigger on any change in managed directories
# hash: {{ joinPath "dot_claude" "**" | glob | join "\n" | sha256sum }}
# hash: {{ joinPath "dot_codex" "**" | glob | join "\n" | sha256sum }}
# hash: {{ joinPath "dot_cursor" "**" | glob | join "\n" | sha256sum }}

source_root="{{ .chezmoi.sourceDir }}"

# Managed sync directories (from routes.txt)
sync_pairs=(
  "dot_claude/skills:$HOME/.claude/skills"
  "dot_claude/agents:$HOME/.claude/agents"
  "dot_claude/contexts:$HOME/.claude/contexts"
  "dot_claude/hooks:$HOME/.claude/hooks"
  "dot_claude/references:$HOME/.claude/references"
  "dot_codex/skills:$HOME/.codex/skills"
  "dot_cursor/skills:$HOME/.cursor/skills"
)

for pair in "${sync_pairs[@]}"; do
  source_dir="$source_root/${pair%%:*}"
  target_dir="${pair##*:}"

  [[ ! -d "$target_dir" ]] && continue
  [[ ! -d "$source_dir" ]] && continue

  # Delete files/dirs in target that don't exist in source
  while IFS= read -r -d '' target_path; do
    rel_path="${target_path#"$target_dir"/}"
    if [[ ! -e "$source_dir/$rel_path" ]]; then
      echo "removing stale: $target_path"
      rm -rf "$target_path"
    fi
  done < <(find "$target_dir" -mindepth 1 -maxdepth 2 -print0)

  # Remove empty directories
  find "$target_dir" -mindepth 1 -type d -empty -delete 2>/dev/null || true
done

# Clean up stale files from removed copy routes
stale_files=(
  "$HOME/.claude/CLAUDE.md"
)

for f in "${stale_files[@]}"; do
  if [[ -f "$f" ]]; then
    echo "removing stale file: $f"
    rm -f "$f"
  fi
done
