#!/bin/bash

# mise config hash: {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }}

{{ if eq .chezmoi.os "darwin" -}}
if [[ -f "/opt/homebrew/bin/brew" ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi
{{ else if eq .chezmoi.os "linux" -}}
if [[ -d "/home/linuxbrew/.linuxbrew" ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
elif [[ -d "$HOME/.linuxbrew" ]]; then
  eval "$($HOME/.linuxbrew/bin/brew shellenv)"
fi
{{ end -}}

{{ if eq .chezmoi.os "linux" -}}
has_libatomic=false
if command -v ldconfig >/dev/null 2>&1; then
  if ldconfig -p 2>/dev/null | grep -q "libatomic.so.1"; then
    has_libatomic=true
  fi
elif ls /usr/lib*/libatomic.so.1 /lib*/libatomic.so.1 >/dev/null 2>&1; then
  has_libatomic=true
fi

if [[ "$has_libatomic" != "true" ]]; then
  if command -v apt-get >/dev/null 2>&1; then
    sudo apt-get update -y && sudo apt-get install -y libatomic1 || {
      echo "failed to install libatomic1 via apt-get" >&2
      exit 1
    }
  elif command -v dnf >/dev/null 2>&1; then
    sudo dnf install -y libatomic || {
      echo "failed to install libatomic via dnf" >&2
      exit 1
    }
  elif command -v pacman >/dev/null 2>&1; then
    sudo pacman -Sy --noconfirm libatomic || {
      echo "failed to install libatomic via pacman" >&2
      exit 1
    }
  elif command -v zypper >/dev/null 2>&1; then
    sudo zypper --non-interactive install libatomic1 || {
      echo "failed to install libatomic1 via zypper" >&2
      exit 1
    }
  else
    echo "libatomic.so.1 not found; install libatomic (libatomic1) with your package manager." >&2
    exit 1
  fi
fi
{{ end -}}

# Mac/Linux: Install node/npm first for npm-based tools
mise install node npm
eval "$(mise activate bash)"
mise install

if command -v playwright-cli >/dev/null 2>&1; then
  playwright-cli install --skills
else
  echo "playwright-cli not found; install via mise (npm:@playwright/cli) before running setup" >&2
  exit 1
fi

if command -v ya >/dev/null 2>&1; then
  if ya --help 2>/dev/null | grep -q '\bpkg\b'; then
    if ! ya pkg install; then
      echo "ya pkg failed; skip yazi plugins" >&2
    fi
  else
    echo "ya pkg not supported; update yazi to use plugins" >&2
  fi
else
  echo "ya not found; skip yazi plugins" >&2
fi
