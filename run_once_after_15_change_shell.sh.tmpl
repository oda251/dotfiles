#!/bin/bash

{{ template "setup-brew-env.sh" . }}

TARGET_ZSH=$(command -v zsh)

if [ -z "$TARGET_ZSH" ]; then
  exit 0
fi

# Check current shell in a cross-platform way
if [[ "$OSTYPE" == "darwin"* ]]; then
    CURRENT_SHELL=$(dscl . -read /Users/$(whoami) UserShell | awk '{print $2}')
else
    CURRENT_SHELL=$(getent passwd $(whoami) | cut -d: -f7)
fi

if [ "$CURRENT_SHELL" = "$TARGET_ZSH" ]; then
  exit 0
fi

if ! grep -Fxq "$TARGET_ZSH" /etc/shells; then
  echo "$TARGET_ZSH" | sudo tee -a /etc/shells
fi

sudo chsh -s "$TARGET_ZSH" "$(whoami)"
