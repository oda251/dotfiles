#!/usr/bin/env bash
set -euo pipefail

# Source nix daemon if available
nix_daemon="/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh"
if [[ -f "$nix_daemon" ]]; then
  # shellcheck disable=SC1090
  source "$nix_daemon"
fi

# Archive existing shell configs so Home Manager can take over
backup_dir="$HOME/.local/share/chezmoi/nix-backups"
mkdir -p "$backup_dir"
for file in "$HOME/.zshrc" "$HOME/.zshenv"; do
  if [[ -e "$file" && ! -L "$file" ]]; then
    timestamp=$(date -u +%Y%m%d%H%M%S)
    mv "$file" "$backup_dir/$(basename "$file").$timestamp"
  fi
done

if ! command -v nix >/dev/null 2>&1; then
  echo "nix not installed yet; run 'chezmoi apply' once to install nix, then reopen your shell and reapply." >&2
  exit 0
fi

export NIX_CONFIG="experimental-features = nix-command flakes"

flake_path="$HOME/flake.nix"
flake_lock_path="$HOME/flake.lock"
flake_dir="$HOME/.local/share/chezmoi-flake"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/chezmoi"
state_path="$state_dir/home-manager-input.sha256"

if [[ ! -f "$flake_path" ]]; then
  echo "flake.nix not found at $flake_path; skipping home-manager switch" >&2
  exit 0
fi

mkdir -p "$state_dir"

hash_mode=""
if command -v sha256sum >/dev/null 2>&1; then
  hash_mode="sha256sum"
elif command -v shasum >/dev/null 2>&1; then
  hash_mode="shasum"
elif command -v openssl >/dev/null 2>&1; then
  hash_mode="openssl"
else
  echo "sha256 tool not found; skipping home-manager switch" >&2
  exit 0
fi

hash_inputs=("$flake_path")
if [[ -f "$flake_lock_path" ]]; then
  hash_inputs+=("$flake_lock_path")
fi

if [[ "$hash_mode" == "sha256sum" ]]; then
  current_signature=$(cat "${hash_inputs[@]}" | sha256sum | awk '{print $1}')
elif [[ "$hash_mode" == "shasum" ]]; then
  current_signature=$(cat "${hash_inputs[@]}" | shasum -a 256 | awk '{print $1}')
else
  current_signature=$(cat "${hash_inputs[@]}" | openssl dgst -sha256 | awk '{print $2}')
fi

if [[ -f "$state_path" ]]; then
  previous_signature=$(<"$state_path")
else
  previous_signature=""
fi

if [[ "$current_signature" == "$previous_signature" && "${CHEZMOI_FORCE_HOME_MANAGER:-0}" != "1" ]]; then
  exit 0
fi

mkdir -p "$flake_dir"
cp "$flake_path" "$flake_dir/flake.nix"
if [[ -f "$flake_lock_path" ]]; then
  cp "$flake_lock_path" "$flake_dir/flake.lock"
fi

system=$(nix eval --raw --impure --expr 'builtins.currentSystem')
nix run home-manager -- switch --flake "$flake_dir#$system"
printf '%s\n' "$current_signature" >"$state_path"
