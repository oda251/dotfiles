terraform {
  required_version = ">= 1.0"

  required_providers {
    github = {
      source  = "integrations/github"
      version = "~> 6.0"
    }
    bitwarden = {
      source  = "maxlaverse/bitwarden"
      version = "~> 0.12"
    }
  }
}

data "bitwarden_item_login" "github_pat" {
  search = "github-pat"
}

provider "github" {
  owner = var.github_owner
  token = data.bitwarden_item_login.github_pat.password
}

# provider "bitwarden" and variables are generated by root terragrunt.hcl

variable "github_owner" {
  description = "GitHub organization or user"
  type        = string
}
