[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	dark = true
	side-by-side = false
	line-numbers = true
[merge]
	conflictstyle = zdiff3
[diff]
	colorMoved = default
[pull]
	rebase = false
