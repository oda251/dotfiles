#!/usr/bin/env bash
# Notify on Claude Code idle / waiting events.
# Fires for Notification (permission prompts, idle, etc.) and Stop (turn end).
set -euo pipefail

input="$(cat)"

event=""
message=""
title=""
cwd=""
notification_type=""
if command -v jq >/dev/null 2>&1; then
  event=$(printf '%s' "$input"        | jq -r '.hook_event_name    // empty')
  message=$(printf '%s' "$input"      | jq -r '.message            // empty')
  title=$(printf '%s' "$input"        | jq -r '.title              // empty')
  cwd=$(printf '%s' "$input"          | jq -r '.cwd                // empty')
  notification_type=$(printf '%s' "$input" | jq -r '.notification_type // empty')
fi

scope=""
if [[ -n "$cwd" ]]; then
  scope="$(basename "$cwd")"
fi
if [[ -n "${ZELLIJ_SESSION_NAME:-}" ]]; then
  # The hook inherits ZELLIJ_PANE_ID from Claude's pane env, so we can
  # resolve THIS Claude's tab unambiguously even with multiple Claude
  # instances across tabs. `list-panes --all` is the only zellij action
  # that exposes per-pane TAB_NAME + PANE_ID; fields are 2-space separated.
  tab=""
  if [[ -n "${ZELLIJ_PANE_ID:-}" ]]; then
    tab=$(zellij action list-panes --all 2>/dev/null \
      | awk -F'  ' -v pid="terminal_${ZELLIJ_PANE_ID}" 'NR>1 && $4 == pid { print $3; exit }' || true)
  fi
  # Fallback: user's currently-focused tab
  if [[ -z "$tab" ]]; then
    tab=$(zellij action current-tab-info 2>/dev/null | awk '/^name:/{sub(/^name: /,""); print; exit}' || true)
  fi
  [[ -n "$tab" ]] && scope="${scope:+$scope · }$tab"
fi

case "$event" in
  Notification)
    heading="${title:-Claude Code}"
    body="${message:-waiting}"
    sound="Ping"
    ;;
  Stop)
    heading="Claude Code"
    body="turn finished"
    sound=""
    ;;
  *)
    heading="Claude Code"
    body="${message:-$event}"
    sound=""
    ;;
esac

[[ -n "$scope" ]] && body="[$scope] $body"

if [[ "$(uname)" == "Darwin" ]]; then
  if [[ -n "$sound" ]]; then
    /usr/bin/osascript \
      -e 'on run argv
display notification item 1 of argv with title item 2 of argv sound name item 3 of argv
end run' \
      "$body" "$heading" "$sound" >/dev/null 2>&1 || true
  else
    /usr/bin/osascript \
      -e 'on run argv
display notification item 1 of argv with title item 2 of argv
end run' \
      "$body" "$heading" >/dev/null 2>&1 || true
  fi
elif grep -qi microsoft /proc/version 2>/dev/null && command -v pwsh.exe >/dev/null 2>&1; then
  # WSL2 → Windows Toast via BurntToast PowerShell module (pwsh / PowerShell 7).
  # PowerShell 5.1 (powershell.exe) won't find BurntToast installed under
  # Documents\PowerShell\Modules — use pwsh exclusively.
  ps_heading="${heading//\'/\'\'}"
  ps_body="${body//\'/\'\'}"
  pwsh.exe -NoProfile -Command \
    "New-BurntToastNotification -Text '$ps_heading','$ps_body'" \
    >/dev/null 2>&1 || true
fi

exit 0
