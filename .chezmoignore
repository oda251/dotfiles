.gitignore
.chezmoiconfig.toml
.chezmoistate
.git
README.md
LICENSE
scripts/
docs/

# Windows-specific configs (ignore on non-Windows systems)
{{ if ne .chezmoi.os "windows" }}
AppData/
Documents/PowerShell/
Documents/WindowsPowerShell/
{{ end }}

# macOS-specific configs (ignore on non-macOS systems)
{{ if ne .chezmoi.os "darwin" }}
.config/ghostty/
{{ end }}

# Ignore all PowerShell scripts on non-Windows
{{ if ne .chezmoi.os "windows" }}
**/*.ps1
{{ end }}

# Mac/Linux-specific configs (ignore on Windows)
{{ if eq .chezmoi.os "windows" }}
# Ignore all shell scripts on Windows
**/*.sh.tmpl

# Nix and Homebrew configuration files
flake.nix.tmpl
flake.lock
dot_Brewfile.tmpl
{{ end }}

