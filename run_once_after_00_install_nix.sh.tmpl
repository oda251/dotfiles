#!/usr/bin/env bash
set -euo pipefail

# Source nix if already installed (multi-user daemon path)
nix_daemon="/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh"
if [[ -f "$nix_daemon" ]]; then
  # shellcheck disable=SC1090
  source "$nix_daemon"
fi

# Move existing shell configs out of the way so Home Manager can manage them
backup_dir="$HOME/.local/share/chezmoi/nix-backups"
mkdir -p "$backup_dir"
for file in "$HOME/.zshrc" "$HOME/.zshenv"; do
  if [[ -e "$file" && ! -L "$file" ]]; then
    timestamp=$(date -u +%Y%m%d%H%M%S)
    mv "$file" "$backup_dir/$(basename "$file").$timestamp"
  fi
done

# Install nix only if truly absent
if ! command -v nix >/dev/null 2>&1; then
  if ! command -v curl >/dev/null 2>&1; then
    echo "curl is required to install Nix" >&2
    exit 1
  fi
  curl -fsSL https://nixos.org/nix/install | sh -s -- --daemon
  # Source again after fresh install
  if [[ -f "$nix_daemon" ]]; then
    # shellcheck disable=SC1090
    source "$nix_daemon"
  fi
fi

# Enable flakes for this session
export NIX_CONFIG="experimental-features = nix-command flakes"

flake_path="$HOME/flake.nix"
flake_dir="$HOME/.local/share/chezmoi-flake"

if [[ -f "$flake_path" ]] && command -v nix >/dev/null 2>&1; then
  mkdir -p "$flake_dir"
  cp "$flake_path" "$flake_dir/flake.nix"
  system=$(nix eval --raw --impure --expr 'builtins.currentSystem' 2>/dev/null || true)
  if [[ -n "$system" ]]; then
    nix run home-manager -- switch --flake "$flake_dir#$system"
  fi
fi
