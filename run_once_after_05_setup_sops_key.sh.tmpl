#!/bin/bash
{{- if ne .chezmoi.os "windows" }}
KEY_FILE="${HOME}/.config/sops/age/keys.txt"

if [ -f "$KEY_FILE" ]; then
  exit 0
fi

if ! command -v infisical >/dev/null 2>&1; then
  echo "⚠ infisical CLI not found. Install it first, then run 'chezmoi apply' again."
  exit 0
fi

echo "=== Fetching SOPS age key from Infisical ==="
key=$(infisical secrets get SOPS_AGE_SECRET_KEY --plain --silent --env prod --path /local 2>/dev/null) || true

if [ -z "$key" ]; then
  echo "⚠ SOPS_AGE_SECRET_KEY not found in Infisical. Set it up manually."
  exit 0
fi

mkdir -p "$(dirname "$KEY_FILE")"
echo "$key" > "$KEY_FILE"
chmod 600 "$KEY_FILE"
echo "✓ SOPS age key saved to $KEY_FILE"
{{- end }}
