#!/usr/bin/env bash
set -euo pipefail

# yazi plugin config hash:
# package: {{ include "dot_config/yazi/package.toml.tmpl" | sha256sum }}
# init: {{ include "dot_config/yazi/init.lua" | sha256sum }}

if ! command -v ya >/dev/null 2>&1; then
  echo "ya not found; skip yazi plugins" >&2
  exit 0
fi

if ! ya --help 2>/dev/null | grep -q '\bpkg\b'; then
  echo "ya pkg not supported; update yazi to use plugins" >&2
  exit 0
fi

ya pkg install
