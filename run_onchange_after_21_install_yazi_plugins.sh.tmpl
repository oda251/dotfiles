#!/usr/bin/env bash
set -euo pipefail

# init.lua hash: {{ include "dot_config/yazi/init.lua" | sha256sum }}

{{ template "setup-brew-env.sh" . }}
{{ template "setup-mise-env.sh" . }}

if ! command -v ya >/dev/null 2>&1; then
  echo "ya not found; skip yazi plugins" >&2
  exit 0
fi

if ! ya --help 2>/dev/null | grep -q '\bpkg\b'; then
  echo "ya pkg not supported; update yazi to use plugins" >&2
  exit 0
fi

sync_yazi_plugins() {
  local package_toml="${HOME}/.config/yazi/package.toml"
  local desired current missing extra

  # TOMLから利用パッケージを抽出し、一意にソートする関数
  extract_uses() {
    sed -n 's/^[[:space:]]*use[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' | sort -u
  }

  desired="$(extract_uses <<'YAZI_PACKAGE_TOML'
{{ include "dot_config/yazi/create_package.toml.tmpl" }}
YAZI_PACKAGE_TOML
)"

  current=""
  if [[ -f "${package_toml}" ]]; then
    current="$(extract_uses <"${package_toml}")"
  fi

  # grep . で確実に空行を排除し、差分を取得
  mapfile -t missing < <(comm -23 <(printf "%s\n" "${desired}" | grep .) <(printf "%s\n" "${current}" | grep .) || true)
  mapfile -t extra < <(comm -13 <(printf "%s\n" "${desired}" | grep .) <(printf "%s\n" "${current}" | grep .) || true)

  # mapfileが空入力を受け取った場合でも誤作動しないよう、要素自体が存在するかチェック
  if [[ ${#missing[@]} -gt 0 && -n "${missing[0]:-}" ]]; then
    echo "Adding yazi packages: ${missing[*]}" >&2
    ya pkg add "${missing[@]}"
  fi

  if [[ ${#extra[@]} -gt 0 && -n "${extra[0]:-}" ]]; then
    echo "Deleting yazi packages: ${extra[*]}" >&2
    ya pkg delete "${extra[@]}" || echo "failed to delete: ${extra[*]}" >&2
  fi

  # ローカルの変更を破棄して強制インストール
  ya pkg install --discard
}

sync_yazi_plugins
